// Riptide Structure — LIT market structure at three nested degrees.
//
// WHY THREE. A single structure degree is either too coarse to trade or too
// noisy to read, and which one it is depends on the chart. The fix is not a
// sensitivity slider — it is to run the SAME engine at three degrees at once
// and let the reader pick which one they are working in:
//
//     MAIN            the slow skeleton.        labels: BOS   Choch   IDM
//     INTERNAL        the leg you trade.        labels: iBOS  iChoch  iIDM
//     DEEP INTERNAL   the entry-timing detail.  labels: iiBOS iiChoch iiIDM
//
// THE DEGREES ARE NOT THREE SETTINGS OF ONE THING. They are a cascade. The
// deep-internal engine reads the candles. Every time it changes character, the
// extreme it came from becomes a PIVOT for the internal engine. Every time the
// internal engine changes character, its extreme becomes a pivot for the main
// engine. So a main-degree swing is, by construction, a move that contained a
// complete internal reversal — which is what "higher degree" actually means,
// and it needs no numeric input to say so.
//
// EVERYTHING ELSE IS IDENTICAL AT ALL THREE. Same inducement rule, same break
// confirmation, same hidden-shadow handling. Only the pivot SOURCE differs.
//
// ── the rest of the design, unchanged from the single-degree version ────────
//
//   NO PIVOT LENGTH INPUT. There is no "5 left, 5 right" anywhere in this
//   file. A pivot is the extreme of a completed PULLBACK: a swing high
//   confirms when price breaks the LOW of the candle that made it, because
//   that break IS the pullback. Two traders on the same chart see the same
//   structure, which a numeric pivot setting is the reason they normally do
//   not.
//
//   INSIDE BARS, PROPERLY. Once a candle sets a range, EVERY candle that stays
//   inside it is noise until that range breaks — not just the next one. A
//   five-candle coil is five inside bars; comparing each candle only to its
//   predecessor calls three of them structure.
//
//   THE INDUCEMENT GATES THE BREAK. Price must collect the liquidity under the
//   last pullback (the IDM) before a break of the high means anything. A high
//   taken with the inducement still sitting there is the trap, and it is drawn
//   as one rather than as a BOS.
//
//   HIDDEN SHADOW. A body can close beyond a level and be back inside it one
//   candle later; on a higher timeframe that is a wick. Body breaks therefore
//   wait one candle, and candles that turn out to be hidden shadows are
//   painted purple.
//
// Nothing here predicts anything. It reads what price has already done and
// draws it the same way every time.

//@version=6
indicator("Riptide Structure — LIT", "Riptide Structure",
     overlay          = true,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 500,
     max_bars_back    = 5000)

// ═════════════════════════════ INPUTS ═══════════════════════════════════════
gDeg   = "Degrees"
gBreak = "Break confirmation"
gShow  = "What to draw"
gCol   = "Colours"

showMain = input.bool(true, "Main structure          BOS / Choch / IDM",
     group = gDeg, tooltip = "The slow skeleton. A main-degree swing is one " +
     "that contained a complete internal reversal, so there are few of them " +
     "and they mark the moves that actually turned the market.")
showInt  = input.bool(true, "Internal              iBOS / iChoch / iIDM",
     group = gDeg, tooltip = "The leg most people trade. Driven by changes of " +
     "character in the deep-internal engine below it.")
showDeep = input.bool(true, "Deep internal      iiBOS / iiChoch / iiIDM",
     group = gDeg, tooltip = "Entry-timing detail, read straight off the " +
     "candles. Densest of the three — turn it off once you know where the " +
     "internal structure is.")

modePb = input.string("Shadow", "Pullback detection",
     options = ["Shadow", "Body", "Body & Sweep"], group = gBreak,
     tooltip = "What confirms a pullback has ENDED, and therefore that a " +
     "pivot exists. Shadow is the right default here: a pullback is a wick " +
     "away from the extreme, and demanding a close makes every pivot late.")
modeIdm = input.string("Shadow", "IDM break",
     options = ["Shadow", "Body", "Body & Sweep"], group = gBreak,
     tooltip = "Taking the inducement is a liquidity event, and liquidity is " +
     "taken by a WICK. Shadow by default for that reason.")
modeBos = input.string("Body & Sweep", "BOS break",
     options = ["Shadow", "Body", "Body & Sweep"], group = gBreak,
     tooltip = "A break of structure should be expensive to claim. Body & " +
     "Sweep wants the level poked and rejected first, then closed through.")
modeCh  = input.string("Body & Sweep", "Choch break",
     options = ["Shadow", "Body", "Body & Sweep"], group = gBreak,
     tooltip = "A change of character rewrites the trend, so it gets the " +
     "strictest confirmation of the four.")

hidBos = input.bool(true, "Hidden Shadow on BOS", group = gBreak,
     tooltip = "A body can close beyond a level and be back inside it one " +
     "candle later — on a higher timeframe that is a wick, not a break. With " +
     "this on, the break waits one candle; if price returns inside, the break " +
     "is cancelled and the candle is painted purple.\n\nHas no effect while " +
     "the break type above is Shadow: a wick break is already a wick break.")
hidCh  = input.bool(true, "Hidden Shadow on Choch", group = gBreak)

labSize = input.string("Small", "Label size",
     options = ["Tiny", "Small", "Normal", "Large"], group = gShow,
     tooltip = "Sets the MAIN degree's label size. Internal and deep internal " +
     "step down from it automatically, so the three degrees stay telling " +
     "apart at a glance rather than all rendering the same.\n\n" +
     "Tiny -> small / tiny / tiny\nSmall -> normal / small / tiny\n" +
     "Normal -> large / normal / small\nLarge -> huge / large / normal\n\n" +
     "Note that even the smallest setting keeps the MAIN labels at Pine's " +
     "'small' rather than 'tiny': the top degree has to stay readable.")

showPb     = input.bool(false, "Pullback zones",        group = gShow,
     tooltip = "OFF by default. Shading every pullback buries the structure " +
     "under boxes, which is the opposite of what a structure tool is for — " +
     "the lines and their labels already say where the pullback was. Turn it " +
     "on only if you specifically want the supply/demand areas filled in.")
showTrap   = input.bool(true,  "Breaks with no IDM taken", group = gShow,
     tooltip = "The LIT trap: a level broken while the inducement below is " +
     "still untouched. Drawn dotted and labelled 'x'. Structure does NOT " +
     "advance on it. Leave this on while learning — the contrast between a " +
     "valid break and a trap is the most useful thing on the chart.")
showSwing  = input.bool(true,  "Swing labels (HH/HL/LH/LL)", group = gShow)
showInside = input.bool(false, "Colour inside bars",    group = gShow)
showPanel  = input.bool(true,  "Trend panel",           group = gShow)
showStats  = input.bool(true,  "LIT statistics table",  group = gShow,
     tooltip = "What actually happened after each structural event on this " +
     "chart, counted rather than asserted. Measured on the deep-internal " +
     "degree, which has enough events to mean something.\n\nIDM -> BOS / " +
     "Choch touch: once the inducement is taken, which level does price " +
     "reach first.\n\nNear -> break or opposite pullback: once price is " +
     "within a quarter of the range of a level, does it break it or turn " +
     "back to the other side.")

// Mapped one-for-one onto the reference indicator's own Theme & Colors panel,
// in its order, so a palette copied from there lands on the right rows here.
cBull   = input.color(#26a69a, "Bullish BOS / CHoCH",  group = gCol)
cBear   = input.color(#f06292, "Bearish BOS / CHoCH",  group = gCol)
cIdmLo  = input.color(#64b5f6, "Bullish IDM (Low)",    group = gCol)
cIdmHi  = input.color(#ffca28, "Bearish IDM (High)",   group = gCol)
cDemand = input.color(#4db6ac, "Demand Pullback",      group = gCol)
cSupply = input.color(#f48fb1, "Supply Pullback",      group = gCol)
// Not in the reference's list — these three mark states it has no equivalent
// of, so they sit below the mapped block rather than inside it.
cTrap   = input.color(#787b86, "Invalid break",        group = gCol)
cHidden = input.color(#9c27b0, "Hidden Shadow",        group = gCol)
cInside = input.color(#b2b5be, "Inside bar",           group = gCol)

// MAIN solid, INTERNAL dashed, DEEP dotted, and the label size stepping down
// with it. Two independent cues for depth means neither has to be read
// carefully: weight says which degree, style confirms it.
lad(int i) =>
    i <= 0 ? size.tiny : i == 1 ? size.small : i == 2 ? size.normal
     : i == 3 ? size.large : size.huge
int baseIdx = labSize == "Tiny" ? 1 : labSize == "Small" ? 2
     : labSize == "Normal" ? 3 : 4
string szMain = lad(baseIdx)
string szInt  = lad(baseIdx - 1)
string szDeep = lad(baseIdx - 2)

// ═════════════════════════ 1. INSIDE BARS ═══════════════════════════════════
// A candle sets a range. Every candle that stays within it is an inside bar,
// until the range's high or low is broken — at which point the breaking candle
// becomes the new range. Structure ignores inside bars entirely.
var float rngHi = na
var float rngLo = na
bool isInside = false
if na(rngHi)
    rngHi := high
    rngLo := low
else if high <= rngHi and low >= rngLo
    isInside := true
else
    rngHi := high
    rngLo := low

// ══════════════════════ 2. BREAK CONFIRMATION ═══════════════════════════════
// Ten hidden-shadow slots: three per degree (IDM, BOS, Choch) plus one for the
// raw pivot rule. A Pine function may not assign a global scalar but MAY
// mutate a global array, because an array is a reference — which is why the
// pending state and the hidden flag both live in arrays.
var pendOn  = array.new<bool>(10, false)
var pendLvl = array.new<float>(10, na)
var pendUp  = array.new<bool>(10, false)
var swept   = array.new<bool>(10, false)
var hidFlag = array.new<bool>(10, false)
array.fill(hidFlag, false)

rawBreak(float lvl, bool up, string mode, bool didSweep) =>
    mode == "Shadow"      ? (up ? high > lvl : low < lvl) :
     mode == "Body"       ? (up ? close > lvl : close < lvl) :
     (up ? close > lvl : close < lvl) and didSweep

wickOnly(float lvl, bool up) =>
    up ? (high > lvl and close <= lvl) : (low < lvl and close >= lvl)

// True only on the bar the break becomes FINAL.
confirmBreak(int slot, float lvl, bool up, string mode, bool useHidden) =>
    bool done = false
    if not na(lvl)
        if wickOnly(lvl, up)
            array.set(swept, slot, true)
        if array.get(pendOn, slot)
            float pl = array.get(pendLvl, slot)
            bool  pu = array.get(pendUp, slot)
            array.set(pendOn, slot, false)
            if pu ? close <= pl : close >= pl
                array.set(hidFlag, slot, true)   // it was a shadow after all
            else
                done := true
        else if rawBreak(lvl, up, mode, array.get(swept, slot))
            if useHidden and mode != "Shadow"
                array.set(pendOn, slot, true)
                array.set(pendLvl, slot, lvl)
                array.set(pendUp, slot, up)
            else
                done := true
    done

// ═══════════════════ 3. RAW PIVOTS, FROM PULLBACKS ══════════════════════════
// No bar count. A swing high confirms when price breaks the LOW of the candle
// that made it — that break IS the pullback, and the pullback is what proves
// the high was a high.
var int   seek   = 1
var float extPx  = na
var int   extT   = na
var float extOpp = na

float rawHi  = na
int   rawHiT = na
float rawLo  = na
int   rawLoT = na

if not isInside
    if na(extPx)
        extPx  := seek > 0 ? high : low
        extT   := time
        extOpp := seek > 0 ? low : high
    else if seek > 0
        if high > extPx
            extPx  := high
            extT   := time
            extOpp := low
        if confirmBreak(9, extOpp, false, modePb, false)
            rawHi  := extPx
            rawHiT := extT
            seek   := -1
            extPx  := low
            extT   := time
            extOpp := high
    else
        if low < extPx
            extPx  := low
            extT   := time
            extOpp := high
        if confirmBreak(9, extOpp, true, modePb, false)
            rawLo  := extPx
            rawLoT := extT
            seek   := 1
            extPx  := high
            extT   := time
            extOpp := low

// ═══════════════════ 4. ONE LIT ENGINE, THREE INSTANCES ═════════════════════
type Deg
    int    slot      = 0
    int    bias      = 0
    float  idm       = na
    int    idmT      = na
    bool   idmTaken  = false
    float  bos       = na
    int    bosT      = na
    float  bosCand   = na
    int    bosCandT  = na
    float  ch        = na
    int    chT       = na
    float  runHi     = na
    int    runHiT    = na
    float  runLo     = na
    int    runLoT    = na
    float  pvHi      = na
    int    pvHiT     = na
    float  pvLo      = na
    int    pvLoT     = na
    float  oldHi     = na
    float  oldLo     = na
    // per-bar events
    bool   sIdm      = false
    bool   sBos      = false
    bool   sCh       = false
    bool   sTrap     = false
    bool   sHi       = false
    bool   sLo       = false
    // what this degree hands UP to the next one on a change of character
    bool   outHi     = false
    bool   outLo     = false
    float  outPx     = na
    int    outT      = na

// One step of the LIT machine. `nHi`/`nLo` are this degree's pivot feed: raw
// candle pivots for the deep degree, the change-of-character extremes of the
// degree below for the other two.
step(Deg d, bool nHi, float pHi, int pHiT, bool nLo, float pLo, int pLoT) =>
    d.sIdm := false
    d.sBos := false
    d.sCh := false
    d.sTrap := false
    d.sHi := false
    d.sLo := false
    d.outHi := false
    d.outLo := false

    if nHi
        d.oldHi := d.pvHi
        d.pvHi  := pHi
        d.pvHiT := pHiT
        d.sHi   := true
    if nLo
        d.oldLo := d.pvLo
        d.pvLo  := pLo
        d.pvLoT := pLoT
        d.sLo   := true

    if not isInside
        if na(d.runHi) or high > d.runHi
            d.runHi  := high
            d.runHiT := time
        if na(d.runLo) or low < d.runLo
            d.runLo  := low
            d.runLoT := time

    // Bootstrap. The first bias is a guess and the first change of character
    // corrects it, which is exactly what a change of character is for.
    if d.bias == 0 and not na(d.pvHi) and not na(d.pvLo)
        d.bias  := d.pvHiT > d.pvLoT ? 1 : -1
        d.ch    := d.bias > 0 ? d.pvLo : d.pvHi
        d.chT   := d.bias > 0 ? d.pvLoT : d.pvHiT
        d.runHi := high
        d.runHiT := time
        d.runLo := low
        d.runLoT := time

    // A new pullback becomes the inducement, replacing any older one, and
    // pins the swing it came from as the level a break must clear. Pinning it
    // HERE is what keeps the level local: read at break time from a running
    // extreme it becomes the high of the whole chart.
    if d.bias > 0 and d.sLo and not d.idmTaken and (na(d.ch) or d.pvLo > d.ch)
        d.idm      := d.pvLo
        d.idmT     := d.pvLoT
        d.bosCand  := d.pvHi
        d.bosCandT := d.pvHiT
        d.runHi    := high
        d.runHiT   := time
    if d.bias < 0 and d.sHi and not d.idmTaken and (na(d.ch) or d.pvHi < d.ch)
        d.idm      := d.pvHi
        d.idmT     := d.pvHiT
        d.bosCand  := d.pvLo
        d.bosCandT := d.pvLoT
        d.runLo    := low
        d.runLoT   := time

    if d.bias != 0
        // step 2 — the inducement is collected
        if not d.idmTaken and not na(d.idm)
            if confirmBreak(d.slot * 3, d.idm, d.bias < 0, modeIdm, false)
                d.idmTaken := true
                d.sIdm := true
                bool useRun = na(d.bosCand) or (d.bias > 0 ? d.runHi > d.bosCand
                     : d.runLo < d.bosCand)
                d.bos  := useRun ? (d.bias > 0 ? d.runHi : d.runLo) : d.bosCand
                d.bosT := useRun ? (d.bias > 0 ? d.runHiT : d.runLoT)
                     : d.bosCandT
                if d.bias > 0
                    d.runLo  := low
                    d.runLoT := time
                else
                    d.runHi  := high
                    d.runHiT := time

        // step 3 — the break
        if not na(d.bos) and confirmBreak(d.slot * 3 + 1, d.bos, d.bias > 0,
             modeBos, hidBos)
            if d.idmTaken
                d.sBos := true
                // The inducement becomes the protected level: it is a real
                // pivot, it is local, and a break of it is exactly what "the
                // inducement failed" means.
                d.ch       := na(d.idm) ? (d.bias > 0 ? d.runLo : d.runHi) : d.idm
                d.chT      := na(d.idm) ? (d.bias > 0 ? d.runLoT : d.runHiT) : d.idmT
                d.idm      := na
                d.idmTaken := false
                d.bos      := na
                d.bosCand  := na
                d.runHi    := high
                d.runHiT   := time
                d.runLo    := low
                d.runLoT   := time
            else
                d.sTrap := true

        // step 4 — character changes, and the degree above hears about it
        if not na(d.ch) and confirmBreak(d.slot * 3 + 2, d.ch, d.bias < 0,
             modeCh, hidCh)
            d.sCh := true
            // The extreme price came FROM is this degree's contribution to the
            // degree above: a swing that contained a whole reversal down here.
            d.outPx := d.bias > 0 ? (na(d.pvHi) ? d.runHi : d.pvHi)
                 : (na(d.pvLo) ? d.runLo : d.pvLo)
            d.outT  := d.bias > 0 ? (na(d.pvHi) ? d.runHiT : d.pvHiT)
                 : (na(d.pvLo) ? d.runLoT : d.pvLoT)
            d.outHi := d.bias > 0
            d.outLo := d.bias < 0
            d.bias     := -d.bias
            d.idm      := na
            d.idmTaken := false
            d.bos      := na
            d.bosCand  := na
            d.ch       := d.outPx
            d.chT      := d.outT
            d.runHi    := high
            d.runHiT   := time
            d.runLo    := low
            d.runLoT   := time
    d

var Deg deep = Deg.new(slot = 0)
var Deg intl = Deg.new(slot = 1)
var Deg main = Deg.new(slot = 2)

// THE CASCADE. Deep reads candles; internal reads deep's changes of character;
// main reads internal's. Called in that order so a flip propagates upward on
// the same bar it happens.
step(deep, not na(rawHi), rawHi, rawHiT, not na(rawLo), rawLo, rawLoT)
step(intl, deep.outHi, deep.outPx, deep.outT, deep.outLo, deep.outPx, deep.outT)
step(main, intl.outHi, intl.outPx, intl.outT, intl.outLo, intl.outPx, intl.outT)

// ═════════════════════════ 5. DRAWING ═══════════════════════════════════════
// Anchored in TIME, never in bar_index: a structural level legitimately sits
// thousands of bars back, and line.new refuses a bar_index further behind than
// max_bars_back (RE10026). xloc.bar_time has no such limit.
lvlLine(float y, int x1, color c, int w, string st) =>
    line.new(x1, y, time, y, xloc = xloc.bar_time, color = c, width = w,
         style = st)

// CENTRED ON THE LINE, and plain text rather than a bubble. A bubble at the
// left end competes with the price action it is drawn over; the text at the midpoint
// of the level reads as part of the line instead of as an annotation stuck to
// one end of it.
tag(float y, int x1, string txt, color c, string sz) =>
    label.new(x1 + (time - x1) / 2, y, txt, xloc = xloc.bar_time,
         style = label.style_none, textcolor = c, size = sz)

// One degree's drawings. Width and label size carry the hierarchy: the main
// structure is meant to be readable at a glance and the deep degree is meant
// to recede.
draw(Deg d, bool on, string pfx, int w, string sz, string st) =>
    if on
        color bc = d.bias > 0 ? cBull : cBear
        if d.sIdm
            color ic = d.bias > 0 ? cIdmLo : cIdmHi
            lvlLine(d.idm, d.idmT, ic, 1, st)
            tag(d.idm, d.idmT, pfx + "IDM", ic, sz)
            if showPb and not na(d.bosCand)
                float top = d.bias > 0 ? d.bosCand : d.idm
                float bot = d.bias > 0 ? d.idm : d.bosCand
                int   lft = d.bias > 0 ? d.bosCandT : d.idmT
                if not na(top) and not na(bot) and not na(lft) and top > bot
                    box.new(lft, top, time, bot, xloc = xloc.bar_time,
                         border_color = color.new(d.bias > 0 ? cDemand
                             : cSupply, 75),
                         bgcolor = color.new(d.bias > 0 ? cDemand : cSupply, 90))
        if d.sBos
            lvlLine(d.bos, d.bosT, bc, w, st)
            tag(d.bos, d.bosT, pfx + "BOS", bc, sz)
        if d.sCh
            // bias has already flipped, so the colour of the move that BROKE
            // is the new one
            lvlLine(d.ch, d.chT, d.bias > 0 ? cBull : cBear, w, st)
            tag(d.ch, d.chT, pfx + "CHoCH", d.bias > 0 ? cBull : cBear, sz)
        if d.sTrap and showTrap
            lvlLine(d.bos, d.bosT, cTrap, 1, line.style_dotted)
            tag(d.bos, d.bosT, "x", cTrap, szDeep)

draw(deep, showDeep, "ii", 1, szDeep, line.style_dotted)
draw(intl, showInt,  "i",  2, szInt,  line.style_dashed)
draw(main, showMain, "",   3, szMain, line.style_solid)

// Swing labels come off the deep degree, the only one that sees every turn.
if showSwing and deep.sHi and not na(deep.pvHi)
    label.new(deep.pvHiT, deep.pvHi,
         na(deep.oldHi) ? "H" : deep.pvHi > deep.oldHi ? "HH" : "LH",
         xloc = xloc.bar_time, style = label.style_label_down,
         color = color.new(cBear, 100), textcolor = cBear, size = szDeep)
if showSwing and deep.sLo and not na(deep.pvLo)
    label.new(deep.pvLoT, deep.pvLo,
         na(deep.oldLo) ? "L" : deep.pvLo < deep.oldLo ? "LL" : "HL",
         xloc = xloc.bar_time, style = label.style_label_up,
         color = color.new(cBull, 100), textcolor = cBull, size = szDeep)

bool hiddenNow = array.includes(hidFlag, true)
barcolor(showInside and isInside ? cInside : hiddenNow ? cHidden : na,
     title = "Inside / Hidden Shadow")

// ═══════════════════════ 6. LIT STATISTICS ══════════════════════════════════
// What actually happened after each structural event ON THIS CHART, counted
// rather than asserted. Measured on the deep degree because it is the only one
// with enough events for a rate to mean anything.
//
// "Near" is a quarter of the BOS-to-Choch range from the level. That threshold
// is mine, not the reference's — theirs is not published — so read the rates as
// a consistent internal measure rather than as a number comparable to theirs.
var int nIdm     = 0
var int nIdmBos  = 0
var int nIdmCh   = 0
var int nBosNear = 0
var int nBosBrk  = 0
var int nBosOpp  = 0
var int nChNear  = 0
var int nChBrk   = 0
var int nChOpp   = 0
var int armIdm = 0        // 0 idle, 1 waiting to see which level is touched
var int armBos = 0
var int armCh  = 0

float span = not na(deep.bos) and not na(deep.ch) ? math.abs(deep.bos - deep.ch)
     : na
if deep.sIdm
    armIdm := 1
    nIdm += 1
if armIdm == 1 and not na(deep.bos) and not na(deep.ch)
    bool hitBos = deep.bias > 0 ? high >= deep.bos : low <= deep.bos
    bool hitCh  = deep.bias > 0 ? low <= deep.ch : high >= deep.ch
    if hitBos
        nIdmBos += 1
        armIdm  := 0
    else if hitCh
        nIdmCh += 1
        armIdm := 0

if not na(span) and span > 0
    bool nearBos = deep.bias > 0 ? high >= deep.bos - span * 0.25
         : low <= deep.bos + span * 0.25
    bool nearCh = deep.bias > 0 ? low <= deep.ch + span * 0.25
         : high >= deep.ch - span * 0.25
    if armBos == 0 and nearBos
        armBos := 1
        nBosNear += 1
    if armBos == 1
        if deep.sBos or deep.sTrap
            nBosBrk += 1
            armBos := 0
        else if nearCh
            nBosOpp += 1
            armBos := 0
    if armCh == 0 and nearCh
        armCh := 1
        nChNear += 1
    if armCh == 1
        if deep.sCh
            nChBrk += 1
            armCh := 0
        else if nearBos
            nChOpp += 1
            armCh := 0

// ═══════════════════════════ 7. PANELS ══════════════════════════════════════
trendTxt(Deg d) =>
    d.bias > 0 ? "Bullish" : d.bias < 0 ? "Bearish" : "—"

waitTxt(Deg d) =>
    na(d.idm) and na(d.bos) ? "waiting for a pullback"
     : not d.idmTaken ? "inducement at " + str.tostring(d.idm, format.mintick) +
         " not yet taken"
     : na(d.bos) ? "inducement taken"
     : "inducement taken — needs " + str.tostring(d.bos, format.mintick) +
         " to continue, " + str.tostring(d.ch, format.mintick) + " to flip"

var table pan = table.new(position.top_right, 2, 5, border_width = 1,
     frame_width = 1, frame_color = color.new(#787b86, 60))
if showPanel and barstate.islast
    table.cell(pan, 0, 0, "LIT", text_color = #787b86, text_size = size.small)
    table.cell(pan, 1, 0, "market structure", text_color = #787b86,
         text_size = size.small)
    table.cell(pan, 0, 1, "Main", text_size = size.small,
         text_color = #787b86)
    table.cell(pan, 1, 1, trendTxt(main), text_size = size.small,
         text_color = main.bias > 0 ? cBull : main.bias < 0 ? cBear : #787b86)
    table.cell(pan, 0, 2, "Internal", text_size = size.small,
         text_color = #787b86)
    table.cell(pan, 1, 2, trendTxt(intl), text_size = size.small,
         text_color = intl.bias > 0 ? cBull : intl.bias < 0 ? cBear : #787b86)
    table.cell(pan, 0, 3, "Deep internal", text_size = size.small,
         text_color = #787b86)
    table.cell(pan, 1, 3, trendTxt(deep), text_size = size.small,
         text_color = deep.bias > 0 ? cBull : deep.bias < 0 ? cBear : #787b86)
    table.cell(pan, 0, 4, "Internal now", text_size = size.tiny,
         text_color = #787b86)
    table.cell(pan, 1, 4, waitTxt(intl), text_size = size.tiny,
         text_color = #787b86)

var table stat = table.new(position.bottom_right, 4, 7, border_width = 1,
     frame_width = 1, frame_color = color.new(#787b86, 60))
row(int r, string lab, int tot, int cnt) =>
    table.cell(stat, 0, r, lab, text_color = #787b86, text_size = size.tiny)
    table.cell(stat, 1, r, str.tostring(tot), text_size = size.tiny,
         text_color = #787b86)
    table.cell(stat, 2, r, str.tostring(cnt), text_size = size.tiny,
         text_color = #787b86)
    table.cell(stat, 3, r, tot > 0 ? str.tostring(100.0 * cnt / tot, "#.#") +
         "%" : "—", text_size = size.tiny,
         text_color = tot > 0 and cnt * 2 > tot ? cBull : cBear)

if showStats and barstate.islast
    table.cell(stat, 0, 0, "Deep-degree statistic", text_color = #787b86,
         text_size = size.tiny)
    table.cell(stat, 1, 0, "Total", text_color = #787b86, text_size = size.tiny)
    table.cell(stat, 2, 0, "Count", text_color = #787b86, text_size = size.tiny)
    table.cell(stat, 3, 0, "Rate", text_color = #787b86, text_size = size.tiny)
    row(1, "IDM → BOS touch",        nIdm, nIdmBos)
    row(2, "IDM → Choch touch",      nIdm, nIdmCh)
    row(3, "BOS near → BOS break",   nBosNear, nBosBrk)
    row(4, "BOS near → opp PB",      nBosNear, nBosOpp)
    row(5, "Choch near → Choch brk", nChNear, nChBrk)
    row(6, "Choch near → opp PB",    nChNear, nChOpp)

// ═══════════════════════════ 8. ALERTS ══════════════════════════════════════
alertcondition(main.sBos, "Main BOS",   "Main structure: break of structure")
alertcondition(main.sCh,  "Main Choch", "Main structure: change of character")
alertcondition(intl.sBos, "Internal BOS", "Internal: break of structure")
alertcondition(intl.sCh,  "Internal Choch", "Internal: change of character")
alertcondition(intl.sIdm, "Internal IDM taken", "Internal: inducement collected")
alertcondition(deep.sIdm, "Deep IDM taken", "Deep internal: inducement collected")
