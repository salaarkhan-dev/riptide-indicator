//@version=5
indicator("Market Structure Inducements ICT CHoch BOS Sweeps", "Market Structure" , overlay = true , max_bars_back = 5000, max_lines_count = 500, max_labels_count = 500)
//Logical Inputs
Engine        = input.string('Period', 'Structure Engine', ['Period', 'Pullback (LIT)'], group = 'Logical Setting',
 tooltip = 'Period: pivots are found by counting candles either side, using the three periods below. Familiar, and two traders with different settings read two different structures.\n\nPullback (LIT): pivots are the extremes of completed pullbacks and there is NO numeric input - a swing high is confirmed when price breaks the low of the candle that made it. One structure per timeframe, the same for everyone. The three periods below are IGNORED in this mode.')
Use_Inside    = input.bool(true, 'Ignore Inside Bars', group = 'Logical Setting',
 tooltip = 'A candle sets a range. EVERY candle that stays inside it is noise until that range is broken - not just the next one. Comparing each candle only with its predecessor calls three bars of a five-bar coil real structure.\n\nWith this on, inside bars are carried forward rather than fed to the detector, so structure is built on bars that actually did something.')
LongP         = input.int(30, 'ChoCh Detector Period', minval = 1, group = 'Logical Setting')
ShortP        = input.int(1, 'BoS & Liquidity Detector Period', minval = 1, group = 'Logical Setting')
InducementP   = input.int(3, 'Inducement Detector Period', minval = 1, group = 'Logical Setting')
FTD           = input.bool(true, 'Fast Trend Detector', group = 'Logical Setting')
//Breakout Rules
BreakSys      = input.string('Simple', 'Breakout System', ['Simple', 'Per Level'], group = 'Breakout Rules',
 tooltip = 'Simple: one setting for the inducement only - the original behaviour. The four Per-Level dropdowns below are IGNORED.\n\nPer Level: Shadow / Body / Body & Sweep chosen separately for the inducement, the BoS and the ChoCh. The Inducement Type Detector above is IGNORED.')
IDMT_Type     = input.string('Sweeps', 'Inducement Type Detector', ['Total', 'Sweeps'], group = 'Breakout Rules',
 tooltip = 'SIMPLE system only. Total: any wick through the level counts. Sweeps: the wick must go through AND the candle close back inside - a real sweep rather than a drift through.')
M_IDM         = input.string('Shadow', 'Breakout type for IDM Level', ['Shadow', 'Body', 'Body & Sweep'], group = 'Breakout Rules',
 tooltip = 'PER LEVEL system only.\n\nShadow: a wick through it is enough. Taking liquidity IS a wick event, which is why the inducement defaults here.\n\nBody: the candle must close beyond it.\n\nBody & Sweep: close beyond the SWEEP LEVEL - the furthest a wick has poked through and failed. With no failed wick it behaves as Body, so it can never deadlock on a level price jumped over.')
M_BoS         = input.string('Body', 'Breakout type for BoS Level', ['Shadow', 'Body', 'Body & Sweep'], group = 'Breakout Rules')
M_ChoCh       = input.string('Body', 'Breakout type for ChoCh Level', ['Shadow', 'Body', 'Body & Sweep'], group = 'Breakout Rules')
HS_IDM        = input.bool(false, 'Hidden Shadow on IDM', group = 'Breakout Rules',
 tooltip = 'A body can close beyond a level and be back inside it one candle later - on a higher timeframe that same move is a wick, not a break. With this on the break WAITS ONE CANDLE; if price returns inside, the break is cancelled and the candle is painted.\n\nNo effect while that level is set to Shadow: a wick break is already a wick break.')
HS_BoS        = input.bool(true,  'Hidden Shadow on BoS', group = 'Breakout Rules')
HS_ChoCh      = input.bool(true,  'Hidden Shadow on ChoCh', group = 'Breakout Rules')
Color_HS      = input.color(#9c27b0, 'Hidden Shadow candle', group = 'Breakout Rules')
//ChoCh Display Inputs
Show_ChoCh    = input.bool(true, 'Show ChoCh Level', group = 'ChoCh Display')
Color_BuChoCh = input.color(#005503, 'Bull', group = 'ChoCh Display', inline = 'ChoCh')
Color_BeChoCh = input.color(#630000  , 'Bear', group = 'ChoCh Display', inline = 'ChoCh')
Size_ChoCh    = input.string(size.small, 'ChoCh Label Size', [size.tiny, size.small, size.normal, size.large, size.auto], group = 'ChoCh Display')
//BoS & LQDY Inputs
Show_BoS      = input.bool(true, 'Show BoS & Liquidity Level', group = 'BoS & LQDY Display')
Color_BuBoS   = input.color(#006bc2, 'Bull', group = 'BoS & LQDY Display', inline = 'BoS')
Color_BeBoS   = input.color(#e79e01  , 'Bear', group = 'BoS & LQDY Display', inline = 'BoS')
Color_LQDY    = input.color(#7905af  , 'LQDY', group = 'BoS & LQDY Display', inline = 'BoS')
Size_BoS      = input.string(size.small, 'BoS & LQDY Label Size', [size.tiny, size.small, size.normal, size.large, size.auto], group = 'BoS & LQDY Display')
//Inducement Display Inputs
Show_IDMT     = input.bool(true, 'Show Inducement Level', group = 'Inducement Display', inline = 'IDMT')
Color_IDMT    = input.color(#666566  , '', group = 'Inducement Display', inline = 'IDMT')
Size_IDMT     = input.string(size.small, 'Inducement Label Size', [size.tiny, size.small, size.normal, size.large, size.auto], group = 'Inducement Display')

//---------------------------------------------------------------------------
//Inside Bars, and the series structure is actually built on
//---------------------------------------------------------------------------
//A candle sets a range; every candle that remains inside it is noise until that
//range breaks. Inside bars carry the last real bar forward, so the detectors
//below never see them.
var float RngHi = na
var float RngLo = na
bool Inside = false
if na(RngHi)
    RngHi := high
    RngLo := low
else if Use_Inside and high <= RngHi and low >= RngLo
    Inside := true
else
    RngHi := high
    RngLo := low

float FH = na
float FL = na
FH := Inside ? nz(FH[1], high) : high
FL := Inside ? nz(FL[1], low)  : low

//---------------------------------------------------------------------------
//Pullback pivots - the LIT engine, with no numeric input at all
//---------------------------------------------------------------------------
//A swing high is confirmed when price breaks the LOW of the candle that made
//it: that break IS the pullback, and the pullback is what proves the high was a
//high. Mirrored for lows. Nothing here counts candles.
var int   Seek   = 1
var float ExtPx  = na
var int   ExtBar = na
var float ExtOpp = na
float PB_H  = na
int   PB_HB = na
float PB_L  = na
int   PB_LB = na
if not Inside
    if na(ExtPx)
        ExtPx  := Seek > 0 ? FH : FL
        ExtBar := bar_index
        ExtOpp := Seek > 0 ? FL : FH
    else if Seek > 0
        if FH > ExtPx
            ExtPx  := FH
            ExtBar := bar_index
            ExtOpp := FL
        if low < ExtOpp
            PB_H   := ExtPx
            PB_HB  := ExtBar
            Seek   := -1
            ExtPx  := FL
            ExtBar := bar_index
            ExtOpp := FH
    else
        if FL < ExtPx
            ExtPx  := FL
            ExtBar := bar_index
            ExtOpp := FH
        if high > ExtOpp
            PB_L   := ExtPx
            PB_LB  := ExtBar
            Seek   := 1
            ExtPx  := FH
            ExtBar := bar_index
            ExtOpp := FL

//Period pivots - the original engine, now reading the inside-bar-free series
pLHP = ta.pivothigh(FH, FTD ? int(LongP/2) : LongP, LongP)
pLLP = ta.pivotlow(FL,  FTD ? int(LongP/2) : LongP, LongP)
pSHP = ta.pivothigh(FH, ShortP, ShortP)
pSLP = ta.pivotlow(FL,  ShortP, ShortP)
pIHP = ta.pivothigh(FH, InducementP, InducementP)
pILP = ta.pivotlow(FL,  InducementP, InducementP)

//One pivot stream per role. In LIT mode all three roles read the SAME pullback
//pivots - the three trackers inside the engine still separate them, because a
//ChoCh level is the highest of them, a BoS level the running one and an
//inducement the latest.
bool LIT = Engine == 'Pullback (LIT)'
float LH = LIT ? PB_H : pLHP
int   LHB = LIT ? PB_HB : bar_index[LongP]
float LL = LIT ? PB_L : pLLP
int   LLB = LIT ? PB_LB : bar_index[LongP]
float SH = LIT ? PB_H : pSHP
int   SHB = LIT ? PB_HB : bar_index[ShortP]
float SL = LIT ? PB_L : pSLP
int   SLB = LIT ? PB_LB : bar_index[ShortP]
float IH = LIT ? PB_H : pIHP
int   IHB = LIT ? PB_HB : bar_index[InducementP]
float IL = LIT ? PB_L : pILP
int   ILB = LIT ? PB_LB : bar_index[InducementP]

//---------------------------------------------------------------------------
//Break confirmation - three modes, plus Hidden Shadow
//---------------------------------------------------------------------------
//Four slots: 0 IDM, 1 BoS, 2 bullish ChoCh, 3 bearish ChoCh. A Pine function
//may not assign a global scalar but MAY mutate a global array, so the pending
//state and the sweep memory both live in arrays.
var PendOn  = array.new_bool(4, false)
var PendLvl = array.new_float(4, na)
var PendUp  = array.new_bool(4, false)
var SwLvl   = array.new_float(4, na)
var SwFor   = array.new_float(4, na)
var HsFlag  = array.new_bool(4, false)
array.fill(HsFlag, false)

Broke(int slot, float lvl, bool up, string mode, bool useHS) =>
    bool done = false
    if not na(lvl)
        //The sweep memory belongs to ONE level; when the level moves, the wicks
        //that failed against the old one say nothing about the new one.
        float sf = array.get(SwFor, slot)
        if na(sf) or sf != lvl
            array.set(SwFor, slot, lvl)
            array.set(SwLvl, slot, na)
        if up ? (high > lvl and close <= lvl) : (low < lvl and close >= lvl)
            float cur = array.get(SwLvl, slot)
            float w = up ? high : low
            array.set(SwLvl, slot, na(cur) ? w : (up ? math.max(cur, w) : math.min(cur, w)))
        bool raw = false
        if mode == 'Shadow'
            raw := up ? high > lvl : low < lvl
        else if mode == 'Body'
            raw := up ? close > lvl : close < lvl
        else
            float sl = array.get(SwLvl, slot)
            float eff = na(sl) ? lvl : (up ? math.max(lvl, sl) : math.min(lvl, sl))
            raw := up ? close > eff : close < eff
        if array.get(PendOn, slot)
            array.set(PendOn, slot, false)
            float pl = array.get(PendLvl, slot)
            bool  pu = array.get(PendUp, slot)
            if pu ? close <= pl : close >= pl
                array.set(HsFlag, slot, true)
            else
                done := true
        else if raw
            if useHS and mode != 'Shadow'
                array.set(PendOn, slot, true)
                array.set(PendLvl, slot, lvl)
                array.set(PendUp, slot, up)
            else
                done := true
    done

//Market Structure Detector Function
Structure(LongP, ShortP, InducementP, FTD, LQDY_Type, Show_ChoCh, Color_BuChoCh, Color_BeChoCh, Size_ChoCh, Show_BoS, Color_BuBoS, Color_BeBoS, Color_LQDY, Size_BoS, Show_IDMT, Color_IDMT, Size_IDMT) => 
    ATR = ta.atr(50)
    //Pivots come from the unified stream above - period-counted or pullback
    //derived depending on the engine, and inside-bar free either way.
    LHP = LH
    LLP = LL
    SHP = SH
    SLP = SL
    IHP = IH
    ILP = IL
    // ChoCh Variable
    var string Trend           = ''
        //Bullish ChoCh
    var float  BuChoCh_P       = 0.0
    var int    BuChoCh_I       = 0
    var int    BuChoCh_IB      = 0
    var int    BuCount         = 0
    var string BuChoCh_B       = ''
    var string BuChoCh_BB      = ''
    var line BuChoCh_Line      = na
    var label BuChoCh_Label    = na
        //Bearish ChoCh
    var float  BeChoCh_P       = 0.0
    var int    BeChoCh_I       = 0
    var int    BeChoCh_IB      = 0
    var int    BeCount         = 0   
    var string BeChoCh_B       = ''
    var string BeChoCh_BB      = ''
    var line BeChoCh_Line      = na   
    var label BeChoCh_Label    = na 
    //Inducement Variable
    var line Inducement_Line   = na 
    var label Inducement_Label = na
    var bool IDM_Permit        = true
    //BoS & Liquidity Variable
    var float High             = 0.0
    var float Low              = 0.0
    var int Index              = 0
    var line BoS_Line          = na 
    var label BoS_Label        = na
    var bool BoS_Permit        = true
    //LIT Gate: has the inducement been collected since the last structural event
    var bool IDM_Swept         = false
    //   \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\/////////////////////////////////////////////////
    //    ||||||||||||||||||||||||||||||||||||||||ChoCh Block||||||||||||||||||||||||||||||||||||||||||
    //   //////////////////////////////////////////////\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
    //Set Point Bullish ChoCh
    if nz(LHP) != 0 
        if Trend == '' or Trend == 'Down Trend'
            BuChoCh_P := LHP
            BuChoCh_I := LHB
        else if Trend == 'Up Trend'
            if LHP > BuChoCh_P
                BuChoCh_P := LHP
                BuChoCh_I := LHB

    //Set Point Bearish ChoCh
    if nz(LLP) != 0
        if Trend == '' or Trend == 'Up Trend'
            BeChoCh_P := LLP
            BeChoCh_I := LLB
        else if Trend == 'Down Trend'
            if LLP < BeChoCh_P
                BeChoCh_P := LLP
                BeChoCh_I := LLB
    //Break
    bool BuHit = Broke(2, BuChoCh_P, true,  BreakSys == 'Simple' ? 'Body' : M_ChoCh, BreakSys == 'Simple' ? false : HS_ChoCh)
    bool BeHit = Broke(3, BeChoCh_P, false, BreakSys == 'Simple' ? 'Body' : M_ChoCh, BreakSys == 'Simple' ? false : HS_ChoCh)
    if BuChoCh_P > 0 and BeChoCh_P > 0
        //Bullish ChoCh
        if BuHit and (Trend == 'Down Trend' or Trend == '')
            Trend     := 'Up Trend'
            BuChoCh_B := 'Break'
            BuChoCh_BB := 'Break'
            BuChoCh_IB := line.get_x1(BuChoCh_Line)
            BuCount := 0
        else
            BuChoCh_B := ''
        //Bearish ChoCh
        if BeHit and (Trend == 'Up Trend' or Trend == '')
            Trend     := 'Down Trend'
            BeChoCh_B := 'Break' 
            BeChoCh_BB := 'Break'
            BeChoCh_IB := line.get_x1(BeChoCh_Line)
            BeCount := 0
        else 
            BeChoCh_B := ''   
    //Clear BoS When ChoCh Formation
    if (BeChoCh_B == 'Break' or BuChoCh_B == 'Break')
        IDM_Swept := false
        if BoS_Permit == true
            line.delete(BoS_Line), label.delete(BoS_Label)
    //Next ChoCh Line
        // Bullish ChoCh Line
    if BuChoCh_I != BuChoCh_I[1] and Trend == 'Down Trend'
        BuChoCh_BB := ''
        BuCount := BuCount + 1 
        if Trend[1] == 'Down Trend' and BuCount > 1
            line.delete(BuChoCh_Line[1]), label.delete(BuChoCh_Label[1])
        if Show_ChoCh
            BuChoCh_Line  := line.new(BuChoCh_I , BuChoCh_P, bar_index, BuChoCh_P, color = color.new(Color_BuChoCh, 30) , style = line.style_solid)
            BuChoCh_Label := label.new(int(math.avg(BuChoCh_I,bar_index)),BuChoCh_P + (ATR * 0.1) , 'Bullish ChoCh' , color = na, 
             textcolor = Color_BuChoCh , style = label.style_label_down , size = Size_ChoCh)
        // Bearish ChoCh Line
    if BeChoCh_I != BeChoCh_I[1] and Trend == 'Up Trend'
        BeChoCh_BB := ''
        BeCount := BeCount + 1 
        if Trend[1] == 'Up Trend' and BeCount > 1
            line.delete(BeChoCh_Line[1]), label.delete(BeChoCh_Label[1]) 
        if Show_ChoCh       
            BeChoCh_Line  := line.new(BeChoCh_I , BeChoCh_P, bar_index, BeChoCh_P, color = color.new(Color_BeChoCh, 30)   , style = line.style_solid)
            BeChoCh_Label := label.new(int(math.avg(BeChoCh_I,bar_index)),BeChoCh_P - (ATR * 0.5) , 'Bearish ChoCh' , color = na,  
             textcolor = Color_BeChoCh , style = label.style_label_up , size = Size_ChoCh)  
    // First ChoCh Line
        // Bullish ChoCh Line
    if BuCount == 0 and BeChoCh_B ==  'Break' and BuChoCh_IB !=  BuChoCh_I 
        BuCount := BuCount + 1 
        if Show_ChoCh
            BuChoCh_Line  := line.new((bar_index-Index) > LongP ? BuChoCh_I : Index, (bar_index-Index) > LongP ? BuChoCh_P : high[bar_index-Index],
             bar_index, (bar_index-Index) > LongP ? BuChoCh_P : high[bar_index-Index], color = color.new(Color_BuChoCh, 30) , style = line.style_solid)
            BuChoCh_Label := label.new(int(math.avg((bar_index-Index) > LongP ? BuChoCh_I : Index,bar_index)),(bar_index-Index) > LongP ? BuChoCh_P + (ATR * 0.1) : high[bar_index-Index] + (ATR * 0.1) , 'Bullish ChoCh' , color = na,  
             textcolor = Color_BuChoCh , style = label.style_label_down , size = Size_ChoCh)
        // Bearish ChoCh Line
    if BeCount == 0 and BuChoCh_B ==  'Break' and BeChoCh_IB !=  BeChoCh_I 
        BeCount := BeCount + 1 
        if Show_ChoCh
            BeChoCh_Line  := line.new((bar_index-Index) > LongP ? BeChoCh_I : Index, (bar_index-Index) > LongP ? BeChoCh_P : low[bar_index-Index],
             bar_index, (bar_index-Index) > LongP ? BeChoCh_P : low[bar_index-Index], color = color.new(Color_BeChoCh, 30)   , style = line.style_solid)
            BeChoCh_Label := label.new(int(math.avg((bar_index-Index) > LongP ? BeChoCh_I : Index,bar_index)),(bar_index-Index) > LongP ? BeChoCh_P- (ATR * 0.5) : low[bar_index-Index] - (ATR * 0.5) , 'Bearish ChoCh' , color = na,  
             textcolor = Color_BeChoCh , style = label.style_label_up , size = Size_ChoCh)                                    
    // Reset ChoCh Line
        // Bullish ChoCh Line    
    if (BuChoCh_I == BuChoCh_I[1] and Trend == 'Down Trend' and BuCount > 0) 
        line.set_x2(BuChoCh_Line , bar_index + 1), label.set_x(BuChoCh_Label, int(math.avg(line.get_x1(BuChoCh_Line),bar_index)))
        // Bearish ChoCh Line
    if (BeChoCh_I == BeChoCh_I[1] and Trend == 'Up Trend' and BeCount > 0)  
        line.set_x2(BeChoCh_Line , bar_index + 1), label.set_x(BeChoCh_Label, int(math.avg(line.get_x1(BeChoCh_Line),bar_index)))
    //   \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\/////////////////////////////////////////////////
    //    |||||||||||||||||||||||||||||||||||BoS & Liquidity Block|||||||||||||||||||||||||||||||||||||
    //   //////////////////////////////////////////////\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
    //BoS & Liquidity in Up Trend
    if Trend == 'Up Trend'
        Low := 0.0
        if nz(SHP) != 0 
            if  High ==  0.0 ? High ==  0.0 : High <= SHP
                High := SHP
                Index :=SHB
                BoS_Permit := true
                if Show_BoS
                    BoS_Line := line.new(SHB, SHP, bar_index, SHP , color = color.new(Color_BuBoS, 30) , style = line.style_dashed)
                    BoS_Label:= label.new(int((SHB + bar_index) / 2), SHP  + (ATR * 0.1), 'BoS', color = na, textcolor = Color_BuBoS , 
                     size = Size_BoS , style = label.style_label_center)
                if BoS_Permit[1] == true
                    line.delete(BoS_Line[1]), label.delete(BoS_Label[1])
        // Reset BoS & Liquidity Line
        if nz(SHP) == 0 and (BoS_Permit )
            line.set_x2(BoS_Line, bar_index), label.set_x(BoS_Label, int((line.get_x1(BoS_Line) + bar_index) / 2))
        // Mitigated BoS Line
        if Broke(1, line.get_y1(BoS_Line), true, BreakSys == 'Simple' ? 'Body' : M_BoS, BreakSys == 'Simple' ? false : HS_BoS) and (BoS_Permit )
            BoS_Permit := false
            //LIT: a high taken while the inducement below is still untouched is
            //the trap, not a break. Structure does not advance on it.
            if IDM_Swept
                IDM_Swept := false
            else
                line.set_style(BoS_Line, line.style_dotted), label.set_text(BoS_Label, 'x')
                label.set_textcolor(BoS_Label, Color_IDMT), line.set_color(BoS_Line, color.new(Color_IDMT, 30))
        // Mitigated and Set Liquidity Line
        if close < line.get_y1(BoS_Line) and high > line.get_y1(BoS_Line) and (BoS_Permit )
            BoS_Permit := false
            line.set_color(BoS_Line, color.new(Color_LQDY, 30)), line.set_style(BoS_Line, line.style_dotted), label.set_text(BoS_Label, 'LQDT'), label.set_textcolor(BoS_Label, Color_LQDY)
    // BoS & Liquidity in Down Trend
    if Trend == 'Down Trend'
        High := 0.0
        if nz(SLP) != 0 
            if  Low == 0.0 ? Low == 0.0 : Low >= SLP
                Low := SLP
                Index :=SLB
                BoS_Permit := true
                if Show_BoS
                    BoS_Line := line.new(SLB, SLP, bar_index, SLP , color = color.new(Color_BeBoS, 30) , style = line.style_dashed)
                    BoS_Label:= label.new(int((SLB + bar_index) / 2), SLP  - (ATR * 0.4), 'BoS', color = na, textcolor = Color_BeBoS , 
                     size = Size_BoS , style = label.style_label_center)
                if BoS_Permit[1] == true
                    line.delete(BoS_Line[1]), label.delete(BoS_Label[1])
        // Reset BoS & Liquidity Line
        if nz(SLP) == 0 and (BoS_Permit )
            line.set_x2(BoS_Line, bar_index), label.set_x(BoS_Label, int((line.get_x1(BoS_Line) + bar_index) / 2))
        // Mitigated BoS Line
        if Broke(1, line.get_y1(BoS_Line), false, BreakSys == 'Simple' ? 'Body' : M_BoS, BreakSys == 'Simple' ? false : HS_BoS) and (BoS_Permit )
            BoS_Permit := false
            //LIT: as above, mirrored.
            if IDM_Swept
                IDM_Swept := false
            else
                line.set_style(BoS_Line, line.style_dotted), label.set_text(BoS_Label, 'x')
                label.set_textcolor(BoS_Label, Color_IDMT), line.set_color(BoS_Line, color.new(Color_IDMT, 30))
        // Mitigated and Set Liquidity Line
        if close > line.get_y1(BoS_Line) and low < line.get_y1(BoS_Line) and (BoS_Permit )
            BoS_Permit := false
            line.set_color(BoS_Line, color.new(Color_LQDY, 30)), line.set_style(BoS_Line, line.style_dotted), label.set_text(BoS_Label, 'LQDT'), label.set_textcolor(BoS_Label, Color_LQDY)        
    //   \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\/////////////////////////////////////////////////
    //    |||||||||||||||||||||||||||||||||||||||Inducement Block||||||||||||||||||||||||||||||||||||||
    //   //////////////////////////////////////////////\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
    // Inducement in Up Trend
    if Trend == 'Up Trend'
        //LIT: the inducement must sit INSIDE the range, never on the CHoCH
        //level itself - a pullback low that IS the reversal level induces
        //nothing, it just restates the boundary.
        if nz(ILP) != 0 and ILP != BeChoCh_P
            IDM_Permit := true
            if Show_IDMT
                Inducement_Line := line.new(ILB, ILP, bar_index, ILP , color = color.new(Color_IDMT, 30) , style = line.style_dotted)
                Inducement_Label := label.new(int((ILB + bar_index) / 2), ILP  - (ATR * 0.4), 'IDMT', color = na, textcolor = Color_IDMT , 
                 size = Size_IDMT , style = label.style_label_center)
            if IDM_Permit[1] == true
                line.delete(Inducement_Line[1]), label.delete(Inducement_Label[1])
        // Reset Inducement Line
        if nz(ILP) == 0 and IDM_Permit == true
            line.set_x2(Inducement_Line, bar_index ), label.set_x(Inducement_Label, int((line.get_x1(Inducement_Line) + bar_index) / 2))
        // Mitigated Inducement Line
        if BreakSys == 'Per Level'
            if Broke(0, line.get_y1(Inducement_Line), false, M_IDM, HS_IDM)
                IDM_Permit := false
                IDM_Swept  := true
        if BreakSys == 'Simple' and IDMT_Type == 'Total' 
            if low < line.get_y1(Inducement_Line)  
                IDM_Permit := false
                IDM_Swept  := true
        if BreakSys == 'Simple' and IDMT_Type == 'Sweeps'
            if low < line.get_y1(Inducement_Line) and close > line.get_y1(Inducement_Line)
                IDM_Permit := false
                IDM_Swept  := true
            if close < line.get_y1(Inducement_Line)
                line.delete(Inducement_Line)
                label.delete(Inducement_Label)

    // Inducement in Down Trend
    if Trend == 'Down Trend'
        //LIT: as above, mirrored.
        if nz(IHP) != 0 and IHP != BuChoCh_P
            IDM_Permit := true
            if Show_IDMT
                Inducement_Line := line.new(IHB, IHP, bar_index, IHP , color = color.new(Color_IDMT, 30) , style = line.style_dotted)
                Inducement_Label := label.new(int((IHB + bar_index) / 2), IHP  + (ATR * 0.1), 'IDMT', color = na, textcolor = Color_IDMT , 
                 size = Size_IDMT , style = label.style_label_center)
            if IDM_Permit[1] == true
                line.delete(Inducement_Line[1]), label.delete(Inducement_Label[1])
        // Reset Inducement Line
        if nz(IHP) == 0 and IDM_Permit 
            line.set_x2(Inducement_Line, bar_index ), label.set_x(Inducement_Label, int((line.get_x1(Inducement_Line) + bar_index) / 2))
        // Mitigated Inducement Line
        if BreakSys == 'Per Level'
            if Broke(0, line.get_y1(Inducement_Line), true, M_IDM, HS_IDM)
                IDM_Permit := false
                IDM_Swept  := true
        if BreakSys == 'Simple' and IDMT_Type == 'Total' 
            if high > line.get_y1(Inducement_Line)  
                IDM_Permit := false
                IDM_Swept  := true
        if BreakSys == 'Simple' and IDMT_Type == 'Sweeps'
            if high > line.get_y1(Inducement_Line) and close < line.get_y1(Inducement_Line)
                IDM_Permit := false
                IDM_Swept  := true
            if close > line.get_y1(Inducement_Line)
                line.delete(Inducement_Line)
                label.delete(Inducement_Label)
//Hidden Shadow candles - a body break that turned out to be a wick
barcolor(array.includes(HsFlag, true) ? Color_HS : na, title = 'Hidden Shadow')

//Call Function
Structure(LongP, ShortP, InducementP, FTD, IDMT_Type, Show_ChoCh, Color_BuChoCh, Color_BeChoCh, Size_ChoCh, Show_BoS, Color_BuBoS, Color_BeBoS, Color_LQDY, Size_BoS, Show_IDMT, Color_IDMT, Size_IDMT)
