[Unit]
Description=Check for Riptide updates every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
# Spread the checks so they do not all land on the bar boundary, where a
# restart would interrupt a scan. The startup scan recovers it either way.
RandomizedDelaySec=90
Persistent=true

[Install]
WantedBy=timers.target
