// This work is licensed under a Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License.
// Structure-detection mechanics (leg/pivot detection, the volatility-parsed
// extreme used to locate order blocks, and the order-block storage and
// mitigation model) are derived from:
//   © LuxAlgo — "Smart Money Concepts [LuxAlgo]"
// Private, non-commercial use. Attribution retained.
//
// The trading model implemented here is the liquidity-sweep reversal described at
//   dailypriceaction.com/blog/liquidity-sweep-reversals/
//   dailypriceaction.com/blog/smc-trading-strategy/
//   dailypriceaction.com/blog/smart-money-concepts/
//
// Every default that departs from those articles departs because a measurement
// in MEASUREMENTS.md says so, and the tooltip carries the number. Where the
// articles and the measurements disagree, both are available as settings and
// the panel at the top right scores whichever you pick. Nothing here is a
// claim; the panel is the claim.
//
//@version=6
indicator('Riptide DPA — Liquidity Sweep Reversals', 'Riptide DPA', overlay = true,
max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// CONSTANTS
// ─────────────────────────────────────────────────────────────────────────────
BULLISH = 1
BEARISH = -1

GREEN   = #089981
RED     = #f23645
AMBER   = #b07d1a
TEAL    = #0e7c86
SLATE   = #5d7276

gMODEL  = '1 · The model'
gLOC    = '2 · Location (OTE)'
gBIAS   = '3 · Higher-timeframe bias'
gRISK   = '4 · Entry, stop and targets'
gDRAW   = '5 · Drawing'
gSTATS  = '6 · Self-test panel'

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
swingLen    = input.int(10, 'Swing pivot length', minval = 2, maxval = 50, group = gMODEL,
     tooltip = 'Bars either side of a pivot. This defines the swing highs whose stops get swept — step 1 of the model.\n\nLuxAlgo uses 50 for external structure and 5 for internal. 10 sits between them: large enough that a pivot means something, small enough to produce setups on a 15m chart.')
minSwings   = input.int(2, 'Swings needed in the pool', minval = 1, maxval = 6, group = gMODEL,
     tooltip = 'How many pivots must sit at roughly the same level before it counts as a liquidity pool. 1 accepts any single swing high; 2+ requires the "equal highs" the articles say attract liquidity.')
poolTolATR  = input.float(0.25, 'Pool tolerance (x ATR)', minval = 0.02, step = 0.01, group = gMODEL,
     tooltip = 'How close two swing highs must be to count as the same pool. The articles say "equal highs" and give no tolerance; a fraction of ATR is the only definition that survives changing the symbol.')
requireClose = input.bool(true, 'Acceptance must be a CLOSE, not a wick', group = gMODEL,
     tooltip = 'Step 3 of the model, verbatim: "acceptance below the low that triggered the sweep". Both articles insist it must be a real candle close through the level, not a wick.\n\nUNTESTED HERE. Riptide\'s engine uses a structure break rather than a close and the two have never been compared, so this is the one article rule that is genuinely an open question rather than a settled one.')
maxWaitBars = input.int(12, 'Bars to wait for acceptance', minval = 1, maxval = 60, group = gMODEL,
     tooltip = 'After the sweep, how long the setup stays live waiting for the close back through. Beyond this the raid is treated as a real breakout, which is what the article calls the invalidation: "if price holds above the sweep level and continues higher, it is likely a real breakout".')

useOTE      = input.bool(true, 'Require the sweep inside the OTE band', group = gLOC,
     tooltip = 'Step 1: "a swing high forms inside the OTE zone". This is the location filter the liquidity-sweep article treats as mandatory.\n\nON by default because it is the article\'s own gate. Note the related 50% premium/discount split measured −0.176 / −0.242 in MEASUREMENTS.md and its edge vanished once stop size was held constant — but that was the 50% HALF, not this 62–79% BAND, and the two are not the same test. Watch the panel with it on and off.')
oteLo       = input.float(62.0, 'OTE band from (%)', minval = 0, maxval = 100, step = 0.5, group = gLOC,
     tooltip = 'The article: "the area between the 62% and 79% retracement" measured from the external high to the external low.')
oteHi       = input.float(79.0, 'OTE band to (%)', minval = 0, maxval = 100, step = 0.5, group = gLOC)
rangeLen    = input.int(60, 'Dealing range lookback (bars)', minval = 20, maxval = 500, group = gLOC,
     tooltip = 'The external high and low that the OTE retracement is measured across. The articles say "external structure" without a number; this is that in bars.')

useBias     = input.bool(true, 'Require higher-timeframe agreement', group = gBIAS,
     tooltip = 'The article calls this mandatory: "without that context, lower-time-frame sweeps are much less reliable".\n\nSupported here too, and it is the strongest single axis measured after the POI: the DAILY trend agreeing scores +0.056 against −0.083 against, +4.5 SE on 8218 signals.\n\nThe CHART\'s own trend is a different thing and sorts nothing — −0.002 across 5792 signals. This reads the higher timeframe, never the chart.')
biasTf      = input.timeframe('D', 'Bias timeframe', group = gBIAS,
     tooltip = 'The articles use 4h and 1h. Daily measured strongest here (+4.5 SE). Set it to 240 or 60 to follow the articles instead.')
biasLen     = input.int(14, 'Bias length', minval = 2, group = gBIAS)
biasFactor  = input.float(5.0, 'Bias factor', minval = 0.5, step = 0.5, group = gBIAS)

entryMode   = input.string('FVG retrace (limit)', 'Entry', options = ['FVG retrace (limit)', 'Acceptance close (market)'], group = gRISK,
     tooltip = 'The article allows both: "may enter on the confirmation candle or wait for retrace into Fair Value Gaps".\n\nThe limit is the default and it is not a formality — market-entering every signal measured −0.064 R on confirmed setups and −0.048 on early ones, and entering at the structure break instead of the gap measured worse on all six arms tested (risk inflates 1.46x because the stop cannot move with the entry).')
fillBars    = input.int(10, 'Bars to leave the limit working', minval = 1, maxval = 60, group = gRISK,
     tooltip = 'Cancelling early costs 0.069 R per setup at 5 bars (2.0 SE). 20–30% never fill; that is a zero, not a loss, and it is priced into every number in the panel.')
stopMode    = input.string('Sweep extreme (measured)', 'Stop', options = ['Sweep extreme (measured)', 'Preceding lower high (article)'], group = gRISK,
     tooltip = 'THE ARTICLES AND THE MEASUREMENTS DISAGREE HERE, so both ship.\n\nThe strategy article puts the stop at "the lower high that formed before the break" — a tighter, structural stop. Every tighter-than-the-raid stop tested here lost: nearest-structure, gap-edge, 5-bar swing, constant-risk chasing, and a 15m stop on a 30m setup which halved the win rate from 56.5% to 27.3%.\n\nThe raid extreme is not a convenient level, it is the price at which the setup is wrong. Switch to the article version and the panel will tell you what it costs on your chart.')
slBufferATR = input.float(0.0, 'Extra room beyond the stop (x ATR)', minval = 0.0, step = 0.05, group = gRISK,
     tooltip = 'The liquidity-sweep article says to place the stop "a few pips above the liquidity sweep high, not directly on that high".\n\nMeasured 0 to 1.0 ATR and ZERO is the peak on both signal types, so the default disagrees with the article. A wider stop is not punished for being wide — it is punished because every R it adds shrinks the same move in R terms.')
targetR     = input.float(3.0, 'Target (R)', minval = 0.5, step = 0.5, group = gRISK,
     tooltip = '3R is the strategy article\'s stated minimum and the sweep article\'s preference, and the measurements agree with the direction: R per signal rises monotonically with the target — 2R +0.093, 3R +0.124, 4R +0.150 across ten targets on 2748 alerts.\n\nIt costs win rate. 2R wins 41%, 3R wins 35%. The win rate is a dial set by this input and nothing else: 0.75R would win 60% and earn +0.003.')
maxRiskATR  = input.float(2.5, 'Skip setups risking more than (x ATR)', minval = 0.0, step = 0.1, group = gRISK,
     tooltip = 'One trade risking 8 ATR carries the size of eight normal ones and dominates the record whichever way it goes. 2.5 measured as the peak: +0.083 R per signal against +0.045 at 3 ATR and −0.005 at 2. 0 turns the check off.')

showZones   = input.bool(true, 'Draw the OTE band and pools', group = gDRAW)
showSetups  = input.bool(true, 'Draw entry, stop and target', group = gDRAW)
showSweeps  = input.bool(true, 'Mark raids that never converted', group = gDRAW,
     tooltip = 'Most raids never produce a setup. Showing the failures is the only way to see the conversion rate rather than the survivors.')
maxDraw     = input.int(20, 'Keep the last N setups drawn', minval = 1, maxval = 100, group = gDRAW)

showPanel   = input.bool(true, 'Show the self-test panel', group = gSTATS,
     tooltip = 'Scores every setup this indicator has drawn on this chart, net of fees. If the panel is not green, the settings above are not working on this symbol — and that is worth more than any tooltip.')
feeMaker    = input.float(0.02, 'Maker fee %', minval = 0, step = 0.01, group = gSTATS,
     tooltip = 'Charged on the entry (a limit) and on a target exit (also a limit).')
feeTaker    = input.float(0.06, 'Taker fee %', minval = 0, step = 0.01, group = gSTATS,
     tooltip = 'Charged on a stop, which is a market order. Cost in R is fee / risk%, so a TIGHT stop pays more per trade — 0.18% risk pays 44% of a 1R loss in fees, 1.09% pays 7%.')
panelPos    = input.string('Top right', 'Panel position', options = ['Top right', 'Top left', 'Bottom right', 'Bottom left'], group = gSTATS)

// ─────────────────────────────────────────────────────────────────────────────
// TYPES
// ─────────────────────────────────────────────────────────────────────────────
type Pool
    float level
    int   swings
    int   barTime
    bool  isHigh
    bool  taken

type Raid
    float extreme          // the wick that took the pool — the measured stop
    float trigLow          // the low/high of the sweep bar; acceptance closes through this
    int   bar
    bool  isHigh           // true = a high was swept, so the trade is a SHORT
    bool  converted
    float structLevel      // the preceding opposite pivot: the article's stop

type Setup
    float entry
    float stop
    float target
    bool  isLong
    int   bar
    bool  filled
    bool  closed
    int   fillBar
    float risk
    bool  won

// ─────────────────────────────────────────────────────────────────────────────
// STATE
// ─────────────────────────────────────────────────────────────────────────────
var array<Pool>  pools   = array.new<Pool>()
var array<Raid>  raids   = array.new<Raid>()
var array<Setup> setups  = array.new<Setup>()
var array<line>  drawnL  = array.new<line>()

var int nSetups = 0, nFilled = 0, nStopped = 0, nTarget = 0, nExpired = 0
var float grossR = 0.0, netR = 0.0
var int nRaids = 0, nConverted = 0

atr = ta.atr(200)

// ─────────────────────────────────────────────────────────────────────────────
// STRUCTURE — derived from LuxAlgo's leg detection. A leg flips when price
// exceeds the extreme of the last `size` bars, which is what makes the pivot
// confirm only after `size` bars have closed beyond it. Non-repainting by
// construction: nothing is decided on the forming bar.
// ─────────────────────────────────────────────────────────────────────────────
leg(int size) =>
    var int l = 0
    bool newHigh = high[size] > ta.highest(size)
    bool newLow  = low[size]  < ta.lowest(size)
    if newHigh
        l := 0
    else if newLow
        l := 1
    l

int  curLeg   = leg(swingLen)
bool newLeg   = ta.change(curLeg) != 0
bool pivotHigh = newLeg and ta.change(curLeg) == -1
bool pivotLow  = newLeg and ta.change(curLeg) == +1

// The volatility-parsed extreme, from LuxAlgo: on a bar whose range is twice
// the average, the wick is noise rather than intent, so the opposite side is
// used when locating a block. Kept because it is the one piece of that script
// with a stated mechanism rather than a convention.
bool wideBar   = (high - low) >= 2 * atr
float pHigh    = wideBar ? low  : high
float pLow     = wideBar ? high : low

var float lastPivotHigh = na
var float lastPivotLow  = na
var int   lastPivotHighBar = na
var int   lastPivotLowBar  = na

if pivotHigh
    lastPivotHigh := high[swingLen]
    lastPivotHighBar := bar_index - swingLen
if pivotLow
    lastPivotLow := low[swingLen]
    lastPivotLowBar := bar_index - swingLen

// ─────────────────────────────────────────────────────────────────────────────
// LIQUIDITY POOLS — swing points clustered within a tolerance. `minSwings` > 1
// is the articles' "equal highs and equal lows", which they say "attract
// liquidity" and "usually become targets".
// ─────────────────────────────────────────────────────────────────────────────
addPivotToPool(float level, bool isHigh, int t) =>
    bool merged = false
    if pools.size() > 0
        for i = 0 to pools.size() - 1
            Pool p = pools.get(i)
            if not merged and p.isHigh == isHigh and not p.taken and
               math.abs(p.level - level) <= poolTolATR * atr
                p.level   := isHigh ? math.max(p.level, level) : math.min(p.level, level)
                p.swings  := p.swings + 1
                p.barTime := t
                merged := true
    if not merged
        pools.push(Pool.new(level, 1, t, isHigh, false))
        if pools.size() > 60
            pools.shift()

if pivotHigh and not na(lastPivotHigh)
    addPivotToPool(lastPivotHigh, true, time[swingLen])
if pivotLow and not na(lastPivotLow)
    addPivotToPool(lastPivotLow, false, time[swingLen])

// ─────────────────────────────────────────────────────────────────────────────
// HIGHER-TIMEFRAME BIAS — request.security with lookahead_off and [1]. This is
// the pattern that does NOT repaint: the value is taken from the last CLOSED
// higher-timeframe bar. LuxAlgo's own drawFairValueGaps uses lookahead_on with
// [0] values, which reads the unfinished HTF bar; that is deliberately not
// copied here.
// ─────────────────────────────────────────────────────────────────────────────
biasDir() =>
    [_sl, _sd] = ta.supertrend(biasFactor, biasLen)
    _sd[1]
htfDir = request.security(syminfo.tickerid, biasTf, biasDir(), lookahead = barmerge.lookahead_off)
// ta.supertrend returns -1 while trending UP. Normalised here so +1 means up,
// matching every other direction in this project. Verified against price, not
// against a comment: getting this backwards inverted every BTC number in
// MEASUREMENTS.md for weeks.
int bias = na(htfDir) ? 0 : (htfDir < 0 ? BULLISH : BEARISH)

// ─────────────────────────────────────────────────────────────────────────────
// DEALING RANGE AND THE OTE BAND
// ─────────────────────────────────────────────────────────────────────────────
float rHigh = ta.highest(high, rangeLen)[1]
float rLow  = ta.lowest(low,  rangeLen)[1]
float rSpan = rHigh - rLow

// For a SHORT the retracement is measured up from the low; for a LONG, down
// from the high. 62–79% is the article's band.
float oteShortLo = rLow + rSpan * oteLo / 100.0
float oteShortHi = rLow + rSpan * oteHi / 100.0
float oteLongHi  = rHigh - rSpan * oteLo / 100.0
float oteLongLo  = rHigh - rSpan * oteHi / 100.0

inOTE(float px, bool isHigh) =>
    bool ok = true
    if useOTE and rSpan > 0
        if isHigh
            ok := px >= oteShortLo and px <= oteShortHi
        else
            ok := px >= oteLongLo and px <= oteLongHi
    ok

// ─────────────────────────────────────────────────────────────────────────────
// STEP 2 — THE SWEEP. Price wicks beyond a pool without accepting there.
// ─────────────────────────────────────────────────────────────────────────────
if pools.size() > 0 and barstate.isconfirmed
    for i = 0 to pools.size() - 1
        Pool p = pools.get(i)
        if not p.taken
            bool tookHigh = p.isHigh and high > p.level and close <= p.level
            bool tookLow  = not p.isHigh and low < p.level and close >= p.level
            if (tookHigh or tookLow) and p.swings >= minSwings and inOTE(p.level, p.isHigh)
                p.taken := true
                nRaids += 1
                float sLevel = p.isHigh ? lastPivotLow : lastPivotHigh
                raids.push(Raid.new(p.isHigh ? high : low, p.isHigh ? low : high,
                     bar_index, p.isHigh, false, sLevel))
                if raids.size() > 40
                    raids.shift()
            else if (tookHigh or tookLow)
                p.taken := true          // consumed, but not a qualifying raid

// ─────────────────────────────────────────────────────────────────────────────
// STEP 3 — ACCEPTANCE. A close back through the low that triggered the sweep.
// This is the article's confirmation, and the one rule here that has never
// been measured against Riptide's structure-break version.
// ─────────────────────────────────────────────────────────────────────────────
newSetup = false
if raids.size() > 0 and barstate.isconfirmed
    for i = 0 to raids.size() - 1
        Raid r = raids.get(i)
        if not r.converted and bar_index - r.bar <= maxWaitBars and bar_index > r.bar
            bool accepted = requireClose ?
                 (r.isHigh ? close < r.trigLow : close > r.trigLow) :
                 (r.isHigh ? low < r.trigLow : high > r.trigLow)
            bool biasOk = not useBias or bias == 0 or (r.isHigh ? bias == BEARISH : bias == BULLISH)
            if accepted and biasOk
                r.converted := true
                nConverted += 1

                bool isLong = not r.isHigh
                float buf   = slBufferATR * atr
                float stopA = r.extreme + (isLong ? -buf : buf)
                float stopB = na(r.structLevel) ? stopA : r.structLevel + (isLong ? -buf : buf)
                float stopPx = stopMode == 'Sweep extreme (measured)' ? stopA : stopB
                float entryPx = entryMode == 'Acceptance close (market)' ? close : r.trigLow
                float risk = math.abs(entryPx - stopPx)

                bool sane = risk > 0 and (isLong ? stopPx < entryPx : stopPx > entryPx)
                bool sized = maxRiskATR <= 0 or risk <= maxRiskATR * atr
                if sane and sized
                    setups.push(Setup.new(entryPx, stopPx,
                         entryPx + (isLong ? 1 : -1) * risk * targetR,
                         isLong, bar_index, false, false, na, risk, false))
                    nSetups += 1
                    newSetup := true
                    if setups.size() > 200
                        setups.shift()

// ─────────────────────────────────────────────────────────────────────────────
// TRACKING — every setup scored the way research/harness.py scores one: the
// stop wins a bar that spans both, the target cannot resolve on the fill bar
// (a limit entry is approached from the wrong side, so the bar's extreme may
// have printed before the fill), and fees are charged in units of R.
// ─────────────────────────────────────────────────────────────────────────────
if setups.size() > 0 and barstate.isconfirmed
    for i = 0 to setups.size() - 1
        Setup s = setups.get(i)
        if not s.closed
            if not s.filled
                bool touched = s.isLong ? low <= s.entry : high >= s.entry
                if touched and bar_index > s.bar
                    s.filled := true
                    s.fillBar := bar_index
                    nFilled += 1
                else if bar_index - s.bar > fillBars
                    s.closed := true
                    nExpired += 1
            else
                float rPct = 100 * s.risk / s.entry
                float feeW = (feeMaker + feeMaker) / rPct
                float feeL = (feeMaker + feeTaker) / rPct
                bool hitStop = s.isLong ? low <= s.stop : high >= s.stop
                bool hitTgt  = bar_index > s.fillBar and (s.isLong ? high >= s.target : low <= s.target)
                if hitStop
                    s.closed := true
                    nStopped += 1
                    grossR -= 1.0
                    netR   -= 1.0 + feeL
                else if hitTgt
                    s.closed := true
                    s.won := true
                    nTarget += 1
                    grossR += targetR
                    netR   += targetR - feeW

// ─────────────────────────────────────────────────────────────────────────────
// DRAWING
// ─────────────────────────────────────────────────────────────────────────────
trimDrawings() =>
    while drawnL.size() > maxDraw * 3
        line.delete(drawnL.shift())

if showZones and barstate.islast and rSpan > 0
    var box oteS = box.new(na, na, na, na, bgcolor = color.new(RED, 90), border_color = color.new(RED, 60))
    var box oteL = box.new(na, na, na, na, bgcolor = color.new(GREEN, 90), border_color = color.new(GREEN, 60))
    box.set_lefttop(oteS, bar_index - rangeLen, oteShortHi)
    box.set_rightbottom(oteS, bar_index + 10, oteShortLo)
    box.set_lefttop(oteL, bar_index - rangeLen, oteLongHi)
    box.set_rightbottom(oteL, bar_index + 10, oteLongLo)

if showSweeps and barstate.isconfirmed and raids.size() > 0
    Raid last = raids.get(raids.size() - 1)
    if last.bar == bar_index
        label.new(bar_index, last.isHigh ? high : low, '✕',
             color = color(na), textcolor = color.new(AMBER, 20),
             style = last.isHigh ? label.style_label_down : label.style_label_up,
             size = size.tiny,
             tooltip = 'Liquidity taken. Most raids never convert — this mark stays whether or not one follows, so the conversion rate on this chart is visible rather than inferred.')

if showSetups and newSetup and setups.size() > 0
    Setup s = setups.get(setups.size() - 1)
    color c = s.isLong ? GREEN : RED
    l1 = line.new(bar_index, s.entry,  bar_index + fillBars, s.entry,  color = TEAL, width = 2)
    l2 = line.new(bar_index, s.stop,   bar_index + fillBars, s.stop,   color = RED, style = line.style_dashed)
    l3 = line.new(bar_index, s.target, bar_index + fillBars, s.target, color = GREEN, style = line.style_dashed)
    drawnL.push(l1)
    drawnL.push(l2)
    drawnL.push(l3)
    label.new(bar_index, s.target, (s.isLong ? '▲ LONG ' : '▼ SHORT ') + str.tostring(targetR, '#.#') + 'R',
         color = color(na), textcolor = c, style = label.style_label_left, size = size.small,
         tooltip = 'sweep → acceptance → entry\n\nEntry ' + str.tostring(s.entry, format.mintick) +
                   '\nStop ' + str.tostring(s.stop, format.mintick) +
                   '  (' + str.tostring(100 * s.risk / s.entry, '#.##') + '% risk)' +
                   '\nTarget ' + str.tostring(s.target, format.mintick) +
                   '\n\nRound-trip fee costs ' + str.tostring((feeMaker + feeTaker) / (100 * s.risk / s.entry), '#.###') +
                   ' R at this stop width. Size by risk, never by margin: notional = account × risk% ÷ stop%.')
    trimDrawings()

// ─────────────────────────────────────────────────────────────────────────────
// PANEL
// ─────────────────────────────────────────────────────────────────────────────
pos() =>
    switch panelPos
        'Top right' => position.top_right
        'Top left' => position.top_left
        'Bottom right' => position.bottom_right
        => position.bottom_left

if showPanel and barstate.islast
    var table t = table.new(pos(), 2, 11, border_width = 1)
    int settled = nStopped + nTarget + nExpired
    int   resolved = nStopped + nTarget
    float winPct = resolved > 0 ? 100.0 * nTarget / resolved : 0.0
    float perSig = settled > 0 ? netR / settled : 0.0
    float convPct = nRaids > 0 ? 100.0 * nConverted / nRaids : 0.0
    color good = netR > 0 ? GREEN : RED

    t.cell(0, 0, 'Riptide DPA', text_color = color.white, bgcolor = TEAL, text_size = size.small)
    t.cell(1, 0, str.tostring(targetR, '#.#') + 'R · ' + timeframe.period,
         text_color = color.white, bgcolor = TEAL, text_size = size.small)

    labels = array.from('Raids', '→ converted', 'Setups', 'Filled', 'Never filled',
         'Target', 'Stopped', 'Win rate', 'Net R', 'R / setup')
    values = array.from(
         str.tostring(nRaids),
         str.tostring(nConverted) + '  ' + str.tostring(convPct, '#') + '%',
         str.tostring(nSetups),
         str.tostring(nFilled) + '  ' + str.tostring(nSetups > 0 ? 100.0 * nFilled / nSetups : 0.0, '#') + '%',
         str.tostring(nExpired),
         str.tostring(nTarget),
         str.tostring(nStopped),
         str.tostring(winPct, '#') + '%',
         str.tostring(netR, '+#.#;-#.#'),
         str.tostring(perSig, '+#.###;-#.###'))

    for i = 0 to labels.size() - 1
        bool isMoney = i >= 8
        t.cell(0, i + 1, labels.get(i), text_color = SLATE, text_size = size.tiny,
             text_halign = text.align_left)
        t.cell(1, i + 1, values.get(i), text_size = size.tiny,
             text_color = isMoney ? good : chart.fg_color,
             text_halign = text.align_right)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(newSetup, 'Setup', 'Riptide DPA: sweep accepted, setup live')
