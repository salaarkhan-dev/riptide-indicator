alertSwingOnly                  = input(        false,      'Swing Events Only',        group = ALERT_GROUP,    tooltip = 'Internal structure fires many times more often than swing structure. Turn this on to be told only about the slower, larger events.')

// WHICH EVENTS MAY SPEAK. Adapted from SMC TFlab, whose settings panel is the
// only one of the three that lets a reader silence an event family without
// editing code. Grouped two to a row rather than one per line — TFlab has a
// separate toggle AND a separate message box for every single event, which is
// why its panel is a mile of scrolling.
alertStructureInput             = input(        true,       'CHoCH / BOS',              group = ALERT_GROUP,    inline = 'ev1')
alertSweepInput                 = input(        true,       'Sweeps ✕',                 group = ALERT_GROUP,    inline = 'ev1')
alertOrderBlockInput            = input(        true,       'OB mitigation',            group = ALERT_GROUP,    inline = 'ev2')
alertEqualInput                 = input(        true,       'EQH / EQL',                group = ALERT_GROUP,    inline = 'ev2')
alertGapInput                   = input(        true,       'FVG',                      group = ALERT_GROUP,    inline = 'ev2')

alertFormatInput                = input.string( 'Readable', 'Message Format',           group = ALERT_GROUP,    tooltip = alertFormatTooltip, options = ['Readable','Compact'])
showSignalArrowInput            = input(        true,       'Signal Arrows ▲▼',         group = ALERT_GROUP,    tooltip = arrowTooltip,  inline = 'ar')
signalArrowSizeInput            = input.string( SMALL,      '',                         group = ALERT_GROUP,    inline = 'ar', options = [TINY,SMALL,NORMAL])
showWatchMarkInput              = input(        true,       'Wait-For-Retest Dots ○',   group = ALERT_GROUP,    tooltip = watchTooltip)
signalWithTrendInput            = input(        true,       'Signals With Structure Only', group = ALERT_GROUP, tooltip = withTrendTooltip)
rejectionModeInput              = input.string( REJ_PIN,    'Rejection Required',       group = ALERT_GROUP,    tooltip = rejectionTooltip, options = [REJ_ANY, REJ_CLOSE, REJ_PIN, REJ_CONFIRM])
pinWickRatioInput               = input.float(  2.0,        'Pin Wick : Body',          group = ALERT_GROUP,    tooltip = pinRatioTooltip,  minval = 1.0, maxval = 6.0, step = 0.5)
marubozuBodyInput               = input.float(  0.7,        'Confirm Body : Range',     group = ALERT_GROUP,    tooltip = marubozuTooltip,  minval = 0.4, maxval = 0.95, step = 0.05)
showSetupBoxInput               = input(        true,       'Outline Zone Awaiting Retest', group = ALERT_GROUP, tooltip = setupBoxTooltip)
showZoneRejectInput             = input(        true,       'Mark Rejections At Zones ▲▼', group = ALERT_GROUP,  tooltip = zoneRejectTooltip)
showPinDebugInput               = input(        false,      'Show Every Pin Candle (debug)', group = ALERT_GROUP, tooltip = pinDebugTooltip)
maxZoneTestsInput               = input.int(    2,          'Tests Allowed Per Zone',   group = ALERT_GROUP,    tooltip = zoneTestsTooltip, minval = 1, maxval = 5)
requireLeaveFirstInput          = input(        true,       'Only After Price Leaves',  group = ALERT_GROUP,    tooltip = leaveFirstTooltip)
showDashInput                   = input(        false,      'Show Status Read-out',     group = ALERT_GROUP,    tooltip = dashTooltip)

// TFlab's six zone-entry alerts, reproduced. Their "Main" is swing structure
// and their "Sub" is internal — that is the whole of the distinction — so the
// base already had all six and only needed to name them.
//
// THEY FIRE ON ENTRY, NOT ON FAILURE, and that is not a detail. LuxAlgo's
// existing OB alerts fire when price closes BEYOND a block, which is the block
// being invalidated. TFlab's fire when price arrives INSIDE the zone, which is
// the entry the message describes. Putting TFlab's wording on LuxAlgo's
// condition would announce a long at the moment demand broke.
alertDemandMainInput            = input(        true,       'Demand Main (swing, CHoCH)',   group = TFLAB_GROUP, inline = 'z1', tooltip = tflabTooltip)
alertSupplyMainInput            = input(        true,       'Supply Main',                  group = TFLAB_GROUP, inline = 'z1')
alertDemandSubInput             = input(        true,       'Demand Sub (internal, CHoCH)', group = TFLAB_GROUP, inline = 'z2')
alertSupplySubInput             = input(        true,       'Supply Sub',                   group = TFLAB_GROUP, inline = 'z2')
alertDemandBosInput             = input(        true,       'Demand BoS',                   group = TFLAB_GROUP, inline = 'z3')
alertSupplyBosInput             = input(        true,       'Supply BoS',                   group = TFLAB_GROUP, inline = 'z3')
alertDemandFvgInput             = input(        true,       'Demand FVG',                   group = TFLAB_GROUP, inline = 'z4', tooltip = fvgZoneTooltip)
alertSupplyFvgInput             = input(        true,       'Supply FVG',                   group = TFLAB_GROUP, inline = 'z4')

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
// @type                            UDT representing alerts as bool fields
type alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false
    // ADDED — the BigBeluga event the base does not model.
    bool swingSweepHigh             = false
    bool swingSweepLow              = false
    bool internalSweepHigh          = false
    bool internalSweepLow           = false
    // ADDED — which tag created the block that just got mitigated. TFlab's
    // taxonomy separates "Demand Main ChoCh" from "Demand BoS"; Main and Sub
    // are simply swing and internal, so the base already knows all four and
    // only needed to say so.
    string bullishOrderBlockOrigin  = ''
    string bearishOrderBlockOrigin  = ''
    // ADDED — TFlab's six, on the ENTRY event rather than the failure event.
    // Main is swing, Sub is internal; that is all their naming means.
    bool demandMainTouch            = false
    bool demandSubTouch             = false
    bool demandBosTouch             = false
    bool supplyMainTouch            = false
    bool supplySubTouch             = false
    bool supplyBosTouch             = false
    bool demandFvgTouch             = false
    bool supplyFvgTouch             = false
    string demandTouchOrigin        = ''
    string supplyTouchOrigin        = ''
    // ADDED — the zone that was entered, so the entry arrow can name the range
    // it is pointing at rather than making a reader guess which box it means.
    float demandTouchTop            = na
    float demandTouchBot            = na
    float supplyTouchTop            = na
    float supplyTouchBot            = na
    // Which of the four actually fired, so the arrow can name it rather than
    // listing the candidates.
    string demandPattern            = ''
    string supplyPattern            = ''
    // DIAGNOSTIC — a pin printed INSIDE a live zone and no arrow came of it.
    // Without this a missing arrow has two indistinguishable causes: the shape
    // was never recognised, or it was recognised and something downstream
    // vetoed it. They need completely different fixes.
    bool pinVetoed                  = false
    // WHY there was no arrow, in words. A bare "something vetoed this" mark
    // still leaves five candidates to guess between, which is most of the work.
    string vetoReason               = ''
    // A rejection candle printed INSIDE a live zone. Not the same thing as the
    // entry arrow: this says the shape happened at the level, the arrow says
    // the whole setup completed. Kept apart because the shape is worth SEEING
    // on the zone that formed it, and the arrow is worth ACTING on.
    bool zoneRejectBull             = false
    bool zoneRejectBear             = false
    string zoneRejectName           = ''
    float zoneRejectTop             = na
    float zoneRejectBot             = na
    // ADDED — A BREAK JUST CUT A ZONE AND THERE IS NOTHING TO DO YET. This is
    // the first half of the setup and it was never modelled: the old build
    // marked the break and marked the entry with the same weight, so a chart
    // could not say "wait" and "go" differently. Armed means the zone exists
    // and price has not come back to it.
    bool demandArmed                = false
    bool supplyArmed                = false
    float armedTop                  = na
    float armedBot                  = na
    string armedOrigin              = ''

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox
    // ADDED — a gap is a zone price comes back to, so it carries exactly the
    // state an order block carries. Note top and bottom are NOT ordered here:
    // a bearish gap is built with top below bottom, so every comparison has to
    // go through math.max / math.min rather than trusting the field names.
    bool touched     = false
    bool leftZone    = false
    int tests        = 0
    int pinAge       = 0

type trend
    int bias

type equalDisplay
    line l_ine      = na
    label l_abel    = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index
    // ADDED — a level may only be swept once, or one long wick logs an event on
    // every bar it stays beyond the level.
    bool swept      = false

type orderBlock
    float barHigh
    float barLow
    int barTime
    int bias
    // ADDED — everything BigBeluga's block needs to be drawn the way it draws.
    //   barVolume  the volume on the origin bar, for the metric label
    //   buyVolume  volume of up-closes since the block formed
    //   sellVolume volume of down-closes since the block formed
    //   origin     CHoCH or BOS, the distinction TFlab's taxonomy is built on
    //   touched    price has entered the zone at least once, so the entry
    //              alert fires ONCE rather than on every bar price sits in it
    float barVolume  = 0.
    float buyVolume  = 0.
    float sellVolume = 0.
    string origin    = ''
    bool touched     = false
    // A block is cut from a bar in the recent past, so on the bar it forms
    // price is usually STILL INSIDE it. Without this the entry fires at
    // formation rather than on a return, which is what put down-arrows in the
    // middle of a rally. Price has to leave the zone before coming back can
    // mean anything.
    bool leftZone    = false
    // HOW MANY SEPARATE RETURNS THIS ZONE HAS ALREADY PRINTED. `touched` used
    // to latch for the block's whole life, so the FIRST brush against it — a
    // one-tick wick on the way past — consumed the zone and the real retest
    // days later printed nothing. `touched` now re-arms whenever price leaves,
    // and this counter is what stops a zone price is oscillating around from
    // printing forever.
    int tests        = 0
    // HOW MANY BARS AGO A PIN PRINTED INSIDE THIS ZONE, 0 for none. An int
    // rather than a flag because the two ways a pin can be confirmed resolve on
    // DIFFERENT BARS: an engulfing marubozu is the very next one, but a fair
    // value gap needs three bars to exist and its middle bar is that next one,
    // so the gap is only visible the bar after. Held per block rather than
    // globally because two zones can be in play at once and a confirmation
    // belongs to the pin that happened in ITS zone.
    int pinAge       = 0
    // The zone's own two marks, owned by the block so they can be REMOVED the
    // moment the setup resolves. Dots that outlive their zone are what turned
    // the chart into a field of circles: every break ever made left one behind
    // whether or not there was still anything to wait for.
    label watchLabel = na
    box setupBox     = na

var pivot swingHigh                 = pivot.new(na,na,false)
var pivot swingLow                  = pivot.new(na,na,false)
var pivot internalHigh              = pivot.new(na,na,false)
var pivot internalLow               = pivot.new(na,na,false)
var pivot equalHigh                 = pivot.new(na,na,false)
var pivot equalLow                  = pivot.new(na,na,false)
var trend swingTrend                = trend.new(0)
var trend internalTrend             = trend.new(0)
var equalDisplay equalHighDisplay   = equalDisplay.new()
var equalDisplay equalLowDisplay    = equalDisplay.new()
var array<fairValueGap> fairValueGaps = array.new<fairValueGap>()
var array<float> parsedHighs        = array.new<float>()
var array<float> parsedLows         = array.new<float>()
var array<float> highs              = array.new<float>()
var array<float> lows               = array.new<float>()
var array<int> times                = array.new<int>()
// ADDED — parallel to the arrays above, so an order block can carry the volume
// that traded on its origin bar without a second pass over history.
var array<float> volumes            = array.new<float>()
var trailingExtremes trailing       = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks      = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks   = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes        = array.new<box>()
var array<box> internalOrderBlocksBoxes     = array.new<box>()
// ADDED — one reusable label per displayed block for the volume metric.
var array<label> swingOrderBlocksLabels     = array.new<label>()
var array<label> internalOrderBlocksLabels  = array.new<label>()
// ADDED — the rest of the BigBeluga block: two activity bars and a midline per
// displayed block. Allocated once, reused every bar, like the boxes above.
var array<box>  swingBuyBoxes               = array.new<box>()
var array<box>  swingSellBoxes              = array.new<box>()
var array<line> swingMidLines               = array.new<line>()
var array<box>  internalBuyBoxes            = array.new<box>()
var array<box>  internalSellBoxes           = array.new<box>()
var array<line> internalMidLines            = array.new<line>()
var swingBullishColor               = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor               = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor        = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor        = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor                = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor               = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput
varip int currentBarIndex           = bar_index
varip int lastBarIndex              = bar_index
alerts currentAlerts                = alerts.new()
var initialTime                     = time
// ADDED — what the read-out shows, and what the last alert said.
var string lastEventText            = 'none yet'
var int lastEventTime               = na

if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))
            swingOrderBlocksLabels.push(label.new(na,na,xloc = xloc.bar_time,color = color(na),style = label.style_label_left,size = size.tiny))
            swingBuyBoxes.push( box.new(na,na,na,na,xloc = xloc.bar_time,border_color = na))
            swingSellBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,border_color = na))
            swingMidLines.push( line.new(na,na,na,na,xloc = xloc.bar_time,style = line.style_dashed))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))
            internalOrderBlocksLabels.push(label.new(na,na,xloc = xloc.bar_time,color = color(na),style = label.style_label_left,size = size.tiny))
            internalBuyBoxes.push( box.new(na,na,na,na,xloc = xloc.bar_time,border_color = na))
            internalSellBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,border_color = na))
            internalMidLines.push( line.new(na,na,na,na,xloc = xloc.bar_time,style = line.style_dashed))

// THE MAIN SIGNALS COULD NOT FIRE, AND NOTHING SAID SO. Demand Main and Supply
// Main are SWING blocks, but swing blocks were only ever stored when 'Swing
// Order Blocks' was ticked — and that display option is OFF by default. So a
// panel showing six zone signals all enabled was really running three: every
// Main alert was silently dead, and Demand/Supply BoS only ever fired off
// internal structure.
//
// Storing is now driven by whether a signal NEEDS the zone, not by whether the
// box is painted. Drawing stays on the display inputs, so nothing new appears
// on the chart — turn 'Swing Order Blocks' on if you want to see the zones the
// Main arrows are pointing at.
swingBlocksLive     = showSwingOrderBlocksInput    or alertDemandMainInput or alertSupplyMainInput or alertDemandBosInput or alertSupplyBosInput
internalBlocksLive  = showInternalOrderBlocksInput or alertDemandSubInput  or alertSupplySubInput  or alertDemandBosInput or alertSupplyBosInput

bearishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : low
atrMeasure                          = ta.atr(200)

//---------------------------------------------------------------------------------------------------------------------}
//CANDLE SHAPES — what a rejection actually looks like
//---------------------------------------------------------------------------------------------------------------------{
// NAMED BY BODY COLOUR, NOT BY LOCATION. That is the operator's convention and
// it is the better one here: colour is in the data, location is a judgement
// about where a move "was", which is exactly the kind of call that cannot be
// coded without smuggling in hindsight.
//
//   long LOWER wick   green body -> HAMMER          red body -> HANGING MAN
//   long UPPER wick   green body -> INVERTED HAMMER red body -> SHOOTING STAR
//
// AND UNDER THAT NAMING THE TWELVE-PATTERN LIST COLLAPSES TO TWO RULES. Read
// the bullish six: hammer, hanging man, then hammer / inverted hammer /
// hanging man / shooting star each with a green marubozu. That is "either
// lower-wick pin on its own" plus "ALL FOUR shapes when a green marubozu
// follows". The bearish six are the same list mirrored. So:
//
//   STANDALONE   the long wick decides.  Lower wick is bullish, upper wick is
//                bearish, whatever colour the body is.
//   CONFIRMED    the MARUBOZU decides.  Any of the four pin shapes, then a
//                green marubozu is bullish and a red one is bearish.
//
// THE SECOND RULE IS THE ONE THE CODE HAD WRONG. It required the pin to already
// point the way the trade did, so a shooting star followed by a green marubozu
// — bullish #6 on the list — could never fire. The pin's job in the two-bar
// case is only to mark that price was rejected AT ALL; the marubozu says which
// way. Once something else settles direction, the pin's own colour and wick
// stop mattering.
candleRng   = high - low
candleBody  = math.abs(close - open)
candleUpper = high - math.max(close, open)
candleLower = math.min(close, open) - low
candleGreen = close > open
candleRed   = close < open

// A pin: the rejecting wick dominates the body and the opposite wick does not.
// No close-position test — the two ratios already force the body into the far
// half, and an explicit close test silently threw out red hanging men, which
// are half of the standalone bullish case.
//
// The opposite-wick allowance is max(body, 10% of range) rather than the body
// alone so a doji-bodied pin, where the body is near zero, is not required to
// have a mathematically perfect zero wick on the other side.
pinLower = candleRng > 0 and candleLower >= pinWickRatioInput * candleBody and candleUpper <= math.max(candleBody, candleRng * 0.1)
pinUpper = candleRng > 0 and candleUpper >= pinWickRatioInput * candleBody and candleLower <= math.max(candleBody, candleRng * 0.1)
pinAny   = pinLower or pinUpper

// The four, by the naming above. Carried separately so the arrow can say which
// one actually fired instead of offering a list of candidates.
patHammer       = pinLower and candleGreen
patHangingMan   = pinLower and candleRed
patInvHammer    = pinUpper and candleGreen
patShootingStar = pinUpper and candleRed

// Standalone direction is the wick.
bullPin = pinLower
bearPin = pinUpper

// CONFIRMATION IS AN ENGULFING MARUBOZU — BOTH CONDITIONS, NOT EITHER. Wicks
// are allowed, but the body has to dominate its own range AND cover the pin's
// body. A marubozu alone can be a small candle that happens to be all body; an
// engulfing alone can be a wide bar that is mostly wick. Neither is the
// decisive candle being described. Requiring both is.
bodyDominant = candleRng > 0 and candleBody >= marubozuBodyInput * candleRng
engulfsPrior = candleBody >= math.abs(close[1] - open[1]) and math.max(close, open) >= math.max(close[1], open[1]) and math.min(close, open) <= math.min(close[1], open[1])
bullConfirm  = candleGreen and bodyDominant and engulfsPrior
bearConfirm  = candleRed   and bodyDominant and engulfsPrior

// DISPLACEMENT — the other way a rejection proves itself. A gap between the
// bar before last and this one means price left so fast nothing traded in
// between, which is the same claim an engulfing marubozu makes and often a
// louder one.
//
// COMPUTED HERE RATHER THAN REUSED FROM drawFairValueGaps(). That function
// reads through request.security at a timeframe the user picks, and it runs
// AFTER this in the bar's order — so its answer is neither available yet nor
// necessarily about these three bars. This is the chart's own timeframe, which
// is the one the zone and the pin live on.
//
// The middle bar has to be directional and the gap has to be at least a tenth
// of its range, so two dojis a tick apart do not count as displacement.
gapUp = low  > high[2] and close[1] > open[1] and (low - high[2]) >= (high[1] - low[1]) * 0.1
gapDn = high < low[2]  and close[1] < open[1] and (low[2] - high) >= (high[1] - low[1]) * 0.1
//---------------------------------------------------------------------------------------------------------------------}

volatilityMeasure                   = orderBlockFilterInput == ATR ? atrMeasure : ta.cum(ta.tr)/bar_index
highVolatilityBar                   = (high - low) >= (2 * volatilityMeasure)
parsedHigh                          = highVolatilityBar ? low : high
parsedLow                           = highVolatilityBar ? high : low

parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)
volumes.push(volume)

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
leg(int size) =>
    var leg     = 0
    newLegHigh  = high[size] > ta.highest( size)
    newLegLow   = low[size]  < ta.lowest(  size)

    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg)      => ta.change(leg) != 0
startOfBearishLeg(int leg)  => ta.change(leg) == -1
startOfBullishLeg(int leg)  => ta.change(leg) == +1

// @function        ADDED — nearest live demand below and supply above, as text.
//
// THIS IS THE HALF OF THE TOOLTIP THAT DOES THE WORK. Knowing a CHoCH fired
// tells a reader to look at the chart; knowing the nearest demand sits at
// 0.03580-0.03604 and came from a swing CHoCH tells them WHERE to look and
// what they would be marking. It is the difference between an alert that opens
// a chart and an alert that starts an analysis.
//
// Nearest means nearest to price, not most recent: the block price would reach
// first is the one that matters, whatever order they formed in.
//
// DEFINED HERE, ABOVE THE DRAWING FUNCTIONS, because the event labels
// themselves now carry the tooltip. Pine resolves top-down, so a helper called
// by drawStructure() has to exist before drawStructure() does.
zoneSummary() =>
    array<orderBlock> everyBlock = array.new<orderBlock>()
    for eachOrderBlock in internalOrderBlocks
        everyBlock.push(eachOrderBlock)
    for eachOrderBlock in swingOrderBlocks
        everyBlock.push(eachOrderBlock)

    float demandTop = na
    float demandBot = na
    string demandTag = ''
    float supplyTop = na
    float supplyBot = na
    string supplyTag = ''

    for eachOrderBlock in everyBlock
        if eachOrderBlock.bias == BULLISH and eachOrderBlock.barHigh <= close
            if na(demandTop) or eachOrderBlock.barHigh > demandTop
                demandTop := eachOrderBlock.barHigh
                demandBot := eachOrderBlock.barLow
                demandTag := eachOrderBlock.origin
        if eachOrderBlock.bias == BEARISH and eachOrderBlock.barLow >= close
            if na(supplyBot) or eachOrderBlock.barLow < supplyBot
                supplyTop := eachOrderBlock.barHigh
                supplyBot := eachOrderBlock.barLow
                supplyTag := eachOrderBlock.origin

    string out = ''
    if not na(supplyTop)
        out := 'supply  ' + str.tostring(supplyBot, format.mintick) + ' – ' + str.tostring(supplyTop, format.mintick) + (supplyTag != '' ? '  ' + supplyTag : '')
    if not na(demandTop)
        out := out + (out != '' ? '\n' : '') + 'demand  ' + str.tostring(demandBot, format.mintick) + ' – ' + str.tostring(demandTop, format.mintick) + (demandTag != '' ? '  ' + demandTag : '')
    out

// @function        ADDED — the hover read-out, attached to the event's OWN label.
//
// THE GLYPH ROW IS GONE AND THIS IS WHY. A separate marker per event bar meant
// a `B` sitting next to the BOS label that already said BOS, a `C` next to the
// CHoCH label, an `✕` next to the ✕ — the same information twice, and on a
// 30-minute chart running beside Riptide it read as clutter rather than signal.
// The labels were always there. They just were not hoverable.
//
// So every event label builds its tooltip through here and nothing extra is
// drawn. One shape for all of them, so a BOS and a sweep read the same way.
//
// SHORT, AND ONLY THINGS THAT ARE TRUE OF THIS BAR. An earlier version wrote a
// paragraph of general advice under every mark — what a retest is, where a stop
// goes in principle. That text was the same on every label, so it carried no
// information about the one being hovered, and it buried the two or three
// numbers that did. Anything that would read identically on every event belongs
// in the settings tooltip, not on the chart.
//
// `level` is the price the event happened AT — the broken level for a break,
// the swept extreme for a sweep. `detail` is whatever is specific to this event
// and may be empty, in which case no blank line is printed for it.
eventTooltip(string headline, float level, string detail) =>
    string sBias = swingTrend.bias    == BULLISH ? 'bull' : swingTrend.bias    == BEARISH ? 'bear' : 'flat'
    string iBias = internalTrend.bias == BULLISH ? 'bull' : internalTrend.bias == BEARISH ? 'bear' : 'flat'
    headline
         + '\n' + str.tostring(level, format.mintick) + '  ·  ' + syminfo.ticker + ' ' + timeframe.period
         + (detail != '' ? '\n\n' + detail : '')
         + '\n\n' + sBias + ' swing  ·  ' + iBias + ' internal'

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>
    var label l_abel = na

    if modeInput == PRESENT
        l_abel.delete()

    l_abel := label.new(chart.point.new(labelTime,na,labelPrice),tag,xloc.bar_time,color=color(na),textcolor=labelColor,style = labelStyle,size = size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay

    string tag          = 'EQL'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up

    if equalHigh
        tag         := 'EQH'
        equalColor  := swingBearishColor
        labelStyle  := label.style_label_down

    if modeInput == PRESENT
        line.delete(    e_qualDisplay.l_ine)
        label.delete(   e_qualDisplay.l_abel)

    e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition           = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel    := label.new(chart.point.new(na,labelPosition,level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput, tooltip = eventTooltip((equalHigh ? 'Equal highs' : 'Equal lows') + '  ·  liquidity pool', level, ''))

getCurrentStructure(int size,bool equalHighLow = false, bool internal = false) =>
    currentLeg              = leg(size)
    newPivot                = startOfNewLeg(currentLeg)
    pivotLow                = startOfBullishLeg(currentLeg)
    pivotHigh               = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot    = equalHighLow ? equalLow : internal ? internalLow : swingLow

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.swept        := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot,high[size],size,true)
                currentAlerts.equalHighs := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.swept        := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.top            := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

// The BOS / CHoCH label is now the hover target. It was already drawn, already
// sits on the level, and already says what fired — so a separate glyph beside
// it was a second copy of the same word. The reading is on the label itself.
drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize, bool bullish, bool internal) =>
    var line l_ine      = line.new(na,na,na,na,xloc = xloc.bar_time)
    var label l_abel    = label.new(na,na)

    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()

    string scope = internal ? 'internal' : 'swing'
    string tip = eventTooltip((bullish ? 'Bullish ' : 'Bearish ') + tag + '  ·  ' + scope, p_ivot.currentLevel, zoneSummary())

    l_ine   := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time,na,p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel  := label.new(chart.point.new(na,math.round(0.5*(p_ivot.barIndex+bar_index)),p_ivot.currentLevel), tag, xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size = labelSize, tooltip = tip)

// @function        ADDED — mark a level that price wicked through but closed back inside.
//
// THE ONE THING BIGBELUGA MODELS THAT NEITHER OTHER INDICATOR DOES. Its
// structure engine tests `high >= level and close <= level` and draws an ✕
// rather than a break, on the reasoning that a level taken by a wick and given
// back is liquidity being collected, not structure changing. That is precisely
// the event the Riptide bot is built around, so it is the single most valuable
// thing to carry across.
//
// The pivot's `swept` flag makes it fire ONCE. Without it a level that price
// sits above for six bars logs six sweeps, and the alert stream becomes
// unreadable — which is the failure mode of most ported indicators.
drawSweep(pivot p_ivot, bool high_side, color sweepColor, bool internal = false) =>
    string scope = internal ? 'internal' : 'swing'
    label.new(chart.point.new(time, na, high_side ? high : low), '✕', xloc.bar_time,
         color = color(na), textcolor = sweepColor,
         style = high_side ? label.style_label_down : label.style_label_up,
         size = size.tiny,
         tooltip = eventTooltip((high_side ? 'Buy-side sweep' : 'Sell-side sweep') + '  ·  ' + scope, p_ivot.currentLevel, ''))

// @function        ADDED — accumulate buy and sell activity inside every live block.
//
// BigBeluga draws two sub-bars inside each block, one above the midline and one
// below, and grows them as bars pass. Its own version advances them on a fixed
// 1-2-3 cycle keyed to the origin candle's colour, which is decorative — the
// bar lengths carry no information about what actually traded.
//
// This keeps the look and makes the lengths mean something: up-close volume
// goes to the buy bar, down-close volume to the sell bar, and each is drawn as
// its share of the elapsed span. Same picture, and now the longer bar is the
// side that actually did the volume.
updateOrderBlockActivity(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    for eachOrderBlock in orderBlocks
        if close >= open
            eachOrderBlock.buyVolume  += volume
        else
            eachOrderBlock.sellVolume += volume

// @function        ADDED — price ENTERED the zone. Not the same event as below.
//
// THIS IS THE DISTINCTION THAT MATTERS AND IT IS EASY TO GET BACKWARDS.
// deleteOrderBlocks() fires when price closes BEYOND a block — the block has
// failed and is removed. TFlab's "mitigation" alerts fire when price arrives
// INSIDE the zone, which is the entry they are named for. They are opposite
// events, and wiring TFlab's message onto LuxAlgo's condition would announce a
// long position at the moment the demand zone broke.
//
// THREE BUGS LIVED IN THIS FUNCTION AND EACH ONE PUT AN ARROW IN THE WRONG
// PLACE OR LEFT THE RIGHT PLACE BARE.
//
//   1  IT SCANNED EVERY STORED BLOCK, NOT THE DRAWN ONES. storeOrdeBlock keeps
//      up to ONE HUNDRED blocks; drawOrderBlocks paints the newest five. The
//      other ninety-five were invisible and still armed, so an arrow could fire
//      off a zone from weeks earlier that is nowhere on the chart. That is the
//      arrow sitting alone in empty space with no box near it. It is now capped
//      to exactly the blocks being displayed: if you cannot see the zone, it
//      cannot signal.
//
//   2  `touched` LATCHED FOR THE BLOCK'S ENTIRE LIFE. The first brush against a
//      zone — a single-tick wick on the way past — consumed it permanently, so
//      the real retest afterwards printed nothing. That is why the good setup
//      (break, return, rejection, run) had no arrow on it. `touched` now clears
//      every time price leaves the zone, and maxZoneTestsInput caps how many
//      separate returns may print.
//
//   3  IT FIRED ON CONTACT, WHICH IS BEFORE ANYTHING IS KNOWN. A wick entering
//      a zone is not a rejection; half of them close straight through. The
//      trigger is now the bar CLOSING back out of the zone's better half — into
//      demand and closing above the midline on an up bar, into supply and
//      closing below it on a down bar. The midline is already drawn, so the
//      test is one a reader can check by eye.
//
// `leftZone` is still what makes this a RETEST rather than a formation. A block
// is cut from a bar in the recent past, so on the bar it forms price is usually
// still inside it — without that guard the entry fires at birth, which is what
// put bearish arrows in the middle of a rally.
touchOrderBlocks(bool internal = false) =>
    array<orderBlock> everyBlock = internal ? internalOrderBlocks : swingOrderBlocks
    int visible = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput

    for [index, eachOrderBlock] in everyBlock
        // PAST THE DISPLAYED WINDOW: no signal, and no leftover marks. A block
        // that has been pushed out by five newer ones is not on the chart, so
        // it must not print an arrow — and its waiting-dot has to go with it,
        // or the chart accumulates one dot per break ever made.
        if index >= visible
            if not na(eachOrderBlock.watchLabel)
                eachOrderBlock.watchLabel.delete()
                eachOrderBlock.watchLabel := na
            if not na(eachOrderBlock.setupBox)
                eachOrderBlock.setupBox.delete()
                eachOrderBlock.setupBox := na
            eachOrderBlock.pinAge := 0
        else
            bool bull    = eachOrderBlock.bias == BULLISH
            bool inNow   = low <= eachOrderBlock.barHigh and high >= eachOrderBlock.barLow
            bool outside = low > eachOrderBlock.barHigh or high < eachOrderBlock.barLow
            float mid    = math.avg(eachOrderBlock.barHigh, eachOrderBlock.barLow)

            // Read BEFORE anything is updated: it is a verdict on an earlier
            // bar's pin and on this bar's close.
            //
            // TWO CONFIRMATIONS ON TWO DIFFERENT BARS. The engulfing marubozu
            // is the bar straight after the pin. A fair value gap cannot be
            // seen that soon — it needs the pin, the displacement bar, and one
            // more to leave the gap standing — so it resolves a bar later, with
            // the displacement bar sitting between the pin and now.
            bool confirmBody = eachOrderBlock.pinAge == 1 and (bull ? bullConfirm : bearConfirm)
            bool confirmGap  = eachOrderBlock.pinAge == 2 and (bull ? gapUp : gapDn)
            bool twoBarFire  = confirmBody or confirmGap

            // Away from the zone: this return is over, arm the next one.
            if outside
                eachOrderBlock.leftZone := true
                eachOrderBlock.touched  := false

            // THE PIN MODE USED TO ALSO DEMAND A CLOSE PAST THE ZONE MIDLINE
            // AND THAT WAS AN INVENTED SECOND FILTER. The pin shape already
            // says the body finished in the far half of ITS OWN range, which is
            // the claim being made; stacking a zone-midline test on top vetoed
            // perfectly good hammers that dipped into the lower part of a wide
            // zone and closed inside it. The zone was still defended. All that
            // is really required is that the candle did not close straight
            // THROUGH the zone, which is what the test is now.
            bool pinNow = bull ? bullPin : bearPin
            // Named on the bar that carries the shape: the pin itself in the
            // one-bar modes, the PREVIOUS bar in the two-bar mode, since that
            // is where the pin was.
            string shapeNow = patHammer ? 'hammer' : patHangingMan ? 'hanging man' : patInvHammer ? 'inverted hammer' : patShootingStar ? 'shooting star' : ''
            string shapePrev = eachOrderBlock.pinAge == 2 ? (patHammer[2] ? 'hammer' : patHangingMan[2] ? 'hanging man' : patInvHammer[2] ? 'inverted hammer' : patShootingStar[2] ? 'shooting star' : '') : (patHammer[1] ? 'hammer' : patHangingMan[1] ? 'hanging man' : patInvHammer[1] ? 'inverted hammer' : patShootingStar[1] ? 'shooting star' : '')
            bool oneBarFire = rejectionModeInput == REJ_ANY ? inNow : rejectionModeInput == REJ_CLOSE ? (inNow and (bull ? (close >= mid and close > open) : (close <= mid and close < open))) : rejectionModeInput == REJ_PIN ? (inNow and pinNow and (bull ? close > eachOrderBlock.barLow : close < eachOrderBlock.barHigh)) : false
            bool fire = rejectionModeInput == REJ_CONFIRM ? twoBarFire : oneBarFire

            // THE SHAPE AT THE ZONE, WITH NONE OF THE ENTRY GATING. No
            // leave-and-return test, no trend filter, no per-zone cap — this is
            // only "a rejection candle printed inside this block", which is the
            // thing worth looking at whether or not it is a tradeable retest.
            // A zone's own formation candles can trip it, and that is correct:
            // they ARE rejections, they are just not entries.
            if inNow and (pinNow or twoBarFire)
                currentAlerts.zoneRejectName := twoBarFire ? (shapePrev == '' ? 'pin + confirm' : shapePrev + (bull ? ' + green marubozu' : ' + red marubozu')) : shapeNow
                currentAlerts.zoneRejectTop  := eachOrderBlock.barHigh
                currentAlerts.zoneRejectBot  := eachOrderBlock.barLow
                if bull
                    currentAlerts.zoneRejectBull := true
                else
                    currentAlerts.zoneRejectBear := true

            // A rejection shape landed in this zone and produced nothing. Name
            // the gate that stopped it, checked in the order they apply, so the
            // answer is on the chart rather than reconstructed afterwards.
            if inNow and pinNow and not (fire and (eachOrderBlock.leftZone or not requireLeaveFirstInput) and not eachOrderBlock.touched and eachOrderBlock.tests < maxZoneTestsInput)
                currentAlerts.pinVetoed := true
                currentAlerts.vetoReason := (requireLeaveFirstInput and not eachOrderBlock.leftZone) ? 'price has not left this zone since it was cut — turn off Only After Price Leaves to signal formations too' : eachOrderBlock.touched ? 'this return already signalled — price has to leave the zone before it can count again' : eachOrderBlock.tests >= maxZoneTestsInput ? 'zone has used all ' + str.tostring(maxZoneTestsInput) + ' of its allowed tests' : 'the shape was found but the rejection test for this mode did not pass'

            if fire and (eachOrderBlock.leftZone or not requireLeaveFirstInput) and not eachOrderBlock.touched and eachOrderBlock.tests < maxZoneTestsInput
                eachOrderBlock.touched    := true
                eachOrderBlock.tests      += 1
                eachOrderBlock.pinAge     := 0

                // The setup resolved, so its waiting marks come off. The zone
                // box drawn by drawOrderBlocks stays — that is the level. This
                // is only the "still waiting" outline.
                if not na(eachOrderBlock.watchLabel)
                    eachOrderBlock.watchLabel.delete()
                    eachOrderBlock.watchLabel := na
                if not na(eachOrderBlock.setupBox)
                    eachOrderBlock.setupBox.delete()
                    eachOrderBlock.setupBox := na

                // TFlab's own labels are explicit about this: "Demand Main Zone,
                // ChoCh Origin", "Demand Sub Zone, ChoCh Origin", "Demand ALL
                // Zone, BoS Origin". So Main and Sub are CHoCH-origin only, and
                // the BoS entry is its own category spanning both. Firing Main for
                // a BOS-origin block would double-count it.
                // In the two-bar mode the shape lives on the PREVIOUS bar and
                // the marubozu on this one, so the label names both.
                string firedShape = rejectionModeInput != REJ_CONFIRM ? shapeNow : shapePrev == '' ? '' : shapePrev + (confirmGap ? ' + displacement gap' : bull ? ' + green marubozu' : ' + red marubozu')
                if bull
                    currentAlerts.demandPattern     := firedShape
                    currentAlerts.demandTouchOrigin := eachOrderBlock.origin
                    currentAlerts.demandTouchTop    := eachOrderBlock.barHigh
                    currentAlerts.demandTouchBot    := eachOrderBlock.barLow
                    if eachOrderBlock.origin == BOS
                        currentAlerts.demandBosTouch  := true
                    else if internal
                        currentAlerts.demandSubTouch  := true
                    else
                        currentAlerts.demandMainTouch := true
                else
                    currentAlerts.supplyPattern     := firedShape
                    currentAlerts.supplyTouchOrigin := eachOrderBlock.origin
                    currentAlerts.supplyTouchTop    := eachOrderBlock.barHigh
                    currentAlerts.supplyTouchBot    := eachOrderBlock.barLow
                    if eachOrderBlock.origin == BOS
                        currentAlerts.supplyBosTouch  := true
                    else if internal
                        currentAlerts.supplySubTouch  := true
                    else
                        currentAlerts.supplyMainTouch := true
            else
                // Remember a pin for the next bar to rule on. Only a pin that
                // is inside the zone and past the leave-and-return test counts,
                // so a pin printed on the bar the block was cut cannot arm.
                // ANY of the four shapes arms the confirmation, because in the
                // two-bar case the marubozu or the gap is what sets direction —
                // a shooting star followed by a green marubozu is a bullish
                // signal. Only the standalone case reads direction off the wick.
                //
                // A fresh pin restarts the clock; otherwise it ages out after
                // two bars, which is the whole window either confirmation has.
                bool newPin = inNow and pinAny and (eachOrderBlock.leftZone or not requireLeaveFirstInput) and not eachOrderBlock.touched and eachOrderBlock.tests < maxZoneTestsInput
                eachOrderBlock.pinAge := newPin ? 1 : eachOrderBlock.pinAge == 1 ? 2 : 0

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks

    for [index,eachOrderBlock] in orderBlocks
        bool crossedOderBlock = false

        if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
            crossedOderBlock := true
            currentAlerts.bearishOrderBlockOrigin := eachOrderBlock.origin
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock    := true
        else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
            crossedOderBlock := true
            currentAlerts.bullishOrderBlockOrigin := eachOrderBlock.origin
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock    := true
        if crossedOderBlock
            // The zone failed, so the "waiting for a retest" marks are now a
            // lie. They come off with the block.
            if not na(eachOrderBlock.watchLabel)
                eachOrderBlock.watchLabel.delete()
            if not na(eachOrderBlock.setupBox)
                eachOrderBlock.setupBox.delete()
            orderBlocks.remove(index)

storeOrdeBlock(pivot p_ivot,bool internal = false,int bias, string origin = '') =>
    if (not internal and swingBlocksLive) or (internal and internalBlocksLive)

        array<float> a_rray = na
        int parsedIndex = na

        if bias == BEARISH
            a_rray      := parsedHighs.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.max())
        else
            a_rray      := parsedLows.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.min())

        // ADDED — the origin bar's volume (BigBeluga) and what created the
        // block (TFlab's distinction), carried on the block itself.
        orderBlock o_rderBlock          = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex), bias, volumes.get(parsedIndex), 0., 0., origin, false, false, 0)
        array<orderBlock> orderBlocks   = internal ? internalOrderBlocks : swingOrderBlocks

        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

        // ARMED — the break left a zone behind and there is nothing to do yet.
        // This is the half of the setup the old build never marked: it drew the
        // break and drew the entry at the same weight, so the chart could not
        // say "wait" and "go" differently.
        //
        // The new block is always at index 0, so it is always one of the drawn
        // ones — which is the condition touchOrderBlocks now enforces too. A
        // zone that arms is a zone that can later signal.
        // Only arm a zone whose entry signal is actually switched on. A dot
        // promising a retest that can never print an arrow is worse than no dot.
        bool canSignal = bias == BULLISH ? (origin == BOS ? alertDemandBosInput : internal ? alertDemandSubInput : alertDemandMainInput) : (origin == BOS ? alertSupplyBosInput : internal ? alertSupplySubInput : alertSupplyMainInput)

        if canSignal
            currentAlerts.armedTop    := o_rderBlock.barHigh
            currentAlerts.armedBot    := o_rderBlock.barLow
            currentAlerts.armedOrigin := origin
            if bias == BULLISH
                currentAlerts.demandArmed := true
            else
                currentAlerts.supplyArmed := true

            // THE MARKS BELONG TO THE BLOCK, NOT TO THE BAR. Drawn once here
            // and deleted by touchOrderBlocks or deleteOrderBlocks the moment
            // the setup resolves — retested, invalidated, or pushed out of the
            // displayed window. Drawing them per-bar was what left a dot on
            // every break the chart had ever made, most of them long dead.
            color zoneCss = bias == BULLISH ? swingBullishColor : swingBearishColor
            float zoneMid = math.avg(o_rderBlock.barHigh, o_rderBlock.barLow)
            string zoneTip = eventTooltip((bias == BULLISH ? 'Demand armed' : 'Supply armed') + (origin != '' ? '  ·  ' + origin : ''), zoneMid, 'zone  ' + str.tostring(o_rderBlock.barLow, format.mintick) + ' – ' + str.tostring(o_rderBlock.barHigh, format.mintick) + '\nwaiting for a rejection in it')

            if showWatchMarkInput
                float dotAt = bias == BULLISH ? o_rderBlock.barLow - atrMeasure * 0.5 : o_rderBlock.barHigh + atrMeasure * 0.5
                o_rderBlock.watchLabel := label.new(chart.point.new(o_rderBlock.barTime, na, dotAt), '', xloc.bar_time, color = color.new(zoneCss, 20), style = label.style_circle, size = size.tiny, tooltip = zoneTip)

            // Outline, not fill. drawOrderBlocks already tints every live zone;
            // a second solid box would say nothing new. A dashed border says
            // "this specific one is still waiting" over the top of that.
            if showSetupBoxInput
                o_rderBlock.setupBox := box.new(chart.point.new(o_rderBlock.barTime, na, o_rderBlock.barHigh), chart.point.new(o_rderBlock.barTime, na, o_rderBlock.barLow), xloc = xloc.bar_time, extend = extend.right, border_color = zoneCss, border_width = 1, border_style = line.style_dashed, bgcolor = color(na))

// @function        Draw the blocks the way BigBeluga draws them.
//
// FOUR PARTS, and the first version of this file only had the first. A plain
// tinted box is what LuxAlgo draws; what makes BigBeluga's read at a glance is
// the rest of it:
//
//   1  the zone itself, extended right
//   2  a dashed MIDLINE — the level price actually reacts to inside the zone
//   3  two ACTIVITY BARS, buy above the midline and sell below, each drawn as
//      its share of the elapsed span, so the longer one is the side doing the
//      volume
//   4  the METRIC — the origin bar's volume and its share of the blocks on
//      screen, which is the number that says which zone is the heavy one
//
// The share is what makes the metric readable. A bare volume figure means
// nothing without something to compare it against, which is why BigBeluga
// prints the percentage beside it and why that is kept here.
drawOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()

    if orderBlocksSize > 0
        maxOrderBlocks                      = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks  = orderBlocks.slice(0, math.min(maxOrderBlocks,orderBlocksSize))
        array<box> b_oxes                   = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes
        array<box> buyBoxes                 = internal ? internalBuyBoxes : swingBuyBoxes
        array<box> sellBoxes                = internal ? internalSellBoxes : swingSellBoxes
        array<line> midLines                = internal ? internalMidLines : swingMidLines
        array<label> l_abels                = internal ? internalOrderBlocksLabels : swingOrderBlocksLabels

        float totalVolume = 0.
        for eachOrderBlock in parsedOrdeBlocks
            totalVolume += eachOrderBlock.barVolume

        for [index,eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)
            float mid       = math.avg(eachOrderBlock.barHigh, eachOrderBlock.barLow)

            box b_ox        = b_oxes.get(index)
            b_ox.set_top_left_point(    chart.point.new(eachOrderBlock.barTime,na,eachOrderBlock.barHigh))
            b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,eachOrderBlock.barLow))
            b_ox.set_border_color(      internal ? color(na) : orderBlockColor)
            b_ox.set_bgcolor(           orderBlockColor)

            // --- 3. the activity bars
            box buyBox  = buyBoxes.get(index)
            box sellBox = sellBoxes.get(index)
            if showOrderBlockActivityInput
                float totalFlow = eachOrderBlock.buyVolume + eachOrderBlock.sellVolume
                int   span      = last_bar_time - eachOrderBlock.barTime
                int   buyRight  = totalFlow > 0 ? eachOrderBlock.barTime + int(span * eachOrderBlock.buyVolume  / totalFlow) : eachOrderBlock.barTime
                int   sellRight = totalFlow > 0 ? eachOrderBlock.barTime + int(span * eachOrderBlock.sellVolume / totalFlow) : eachOrderBlock.barTime
                buyBox.set_top_left_point(      chart.point.new(eachOrderBlock.barTime,na,eachOrderBlock.barHigh))
                buyBox.set_bottom_right_point(  chart.point.new(buyRight,na,mid))
                buyBox.set_bgcolor(             orderBlockActivityUpInput)
                buyBox.set_border_color(        color(na))
                sellBox.set_top_left_point(     chart.point.new(eachOrderBlock.barTime,na,mid))
                sellBox.set_bottom_right_point( chart.point.new(sellRight,na,eachOrderBlock.barLow))
                sellBox.set_bgcolor(            orderBlockActivityDnInput)
                sellBox.set_border_color(       color(na))
            else
                buyBox.set_bgcolor(color(na))
                sellBox.set_bgcolor(color(na))

            // --- 2. the midline
            line midLine = midLines.get(index)
            if showOrderBlockMidLineInput
                midLine.set_first_point(  chart.point.new(eachOrderBlock.barTime,na,mid))
                midLine.set_second_point( chart.point.new(last_bar_time,na,mid))
                midLine.set_color(        color.new(orderBlockColor, 0))
            else
                midLine.set_color(color(na))

            // --- 4. the metric
            label l_abel = l_abels.get(index)
            if showOrderBlockVolumeInput or showOrderBlockOriginInput
                string share = showOrderBlockVolumeInput and totalVolume > 0 ? str.tostring(eachOrderBlock.barVolume, format.volume) + '  (' + str.tostring(math.round(eachOrderBlock.barVolume / totalVolume * 100)) + '%)' : ''
                string tag   = showOrderBlockOriginInput and eachOrderBlock.origin != '' ? (share == '' ? eachOrderBlock.origin : share + '  ' + eachOrderBlock.origin) : share
                l_abel.set_point(       chart.point.new(last_bar_time,na,mid))
                l_abel.set_text(        tag)
                l_abel.set_textcolor(   color.new(orderBlockColor, 0))
                l_abel.set_size(        orderBlockTextSizeInput)
                l_abel.set_style(       label.style_label_left)
            else
                l_abel.set_text('')

displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true

    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)

    pivot p_ivot    = internal ? internalHigh : swingHigh
    trend t_rend    = internal ? internalTrend : swingTrend

    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize

    extraCondition  = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor    = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput

    // ADDED — the sweep test comes BEFORE the break test, and it must, because
    // the two are mutually exclusive readings of the same bar: price went
    // through the level and either stayed (a break) or did not (a sweep).
    // Checking the break first would let a wick-and-reject be logged as a
    // structure change on the bar it is refuted.
    if showSweepsInput and (not internal or sweepInternalInput) and not p_ivot.crossed and not p_ivot.swept and not na(p_ivot.currentLevel)
        if high >= p_ivot.currentLevel and close < p_ivot.currentLevel
            p_ivot.swept := true
            if internal
                currentAlerts.internalSweepHigh := true
            else
                currentAlerts.swingSweepHigh    := true
            drawSweep(p_ivot, true, styleInput == MONOCHROME ? MONO_BEARISH : sweepBearColorInput, internal)

    if ta.crossover(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBullishCHoCH  := tag == CHOCH
            currentAlerts.internalBullishBOS    := tag == BOS
        else
            currentAlerts.swingBullishCHoCH     := tag == CHOCH
            currentAlerts.swingBullishBOS       := tag == BOS

        p_ivot.crossed  := true
        t_rend.bias     := BULLISH

        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))

        if displayCondition
            drawStructure(p_ivot,tag,bullishColor,lineStyle,label.style_label_down,labelSize,true,internal)

        if (internal and internalBlocksLive) or (not internal and swingBlocksLive)
            storeOrdeBlock(p_ivot,internal,BULLISH,tag)

    p_ivot          := internal ? internalLow : swingLow
    extraCondition  := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor    = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    if showSweepsInput and (not internal or sweepInternalInput) and not p_ivot.crossed and not p_ivot.swept and not na(p_ivot.currentLevel)
        if low <= p_ivot.currentLevel and close > p_ivot.currentLevel
            p_ivot.swept := true
            if internal
                currentAlerts.internalSweepLow  := true
            else
                currentAlerts.swingSweepLow     := true
            drawSweep(p_ivot, false, styleInput == MONOCHROME ? MONO_BULLISH : sweepBullColorInput, internal)

    if ta.crossunder(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBearishCHoCH  := tag == CHOCH
            currentAlerts.internalBearishBOS    := tag == BOS
        else
            currentAlerts.swingBearishCHoCH     := tag == CHOCH
            currentAlerts.swingBearishBOS       := tag == BOS

        p_ivot.crossed := true
        t_rend.bias := BEARISH

        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))

        if displayCondition
            drawStructure(p_ivot,tag,bearishColor,lineStyle,label.style_label_up,labelSize,false,internal)

        if (internal and internalBlocksLive) or (not internal and swingBlocksLive)
            storeOrdeBlock(p_ivot,internal,BEARISH,tag)

fairValueGapBox(leftTime,rightTime,topPrice,bottomPrice,boxColor) => box.new(chart.point.new(leftTime,na,topPrice),chart.point.new(rightTime + fairValueGapsExtendInput * (time-time[1]),na,bottomPrice), xloc=xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

// @function        ADDED — a gap is a zone too, so it gets the same treatment.
//
// SAME RULES AS touchOrderBlocks AND DELIBERATELY SO. A fair value gap is where
// price moved so fast it left something behind, which is the same claim an
// order block makes about a candle; both are levels price comes back to. Giving
// gaps a weaker or different test would mean two kinds of signal wearing the
// same arrow.
//
// THE ONE THING THAT IS NOT THE SAME is the geometry. A bearish gap is built
// with `top` BELOW `bottom` — that is how the base constructs it and the boxes
// render fine either way — so every comparison here goes through math.max and
// math.min instead of trusting the field names. Reading them literally silently
// inverts every bearish gap.
//
// No visible-window cap either, because every live gap is drawn: the base
// deletes them on mitigation rather than keeping a hidden backlog, so "on the
// chart" and "in the array" already mean the same thing.
touchFairValueGaps() =>
    for eachFairValueGap in fairValueGaps
        float zTop   = math.max(eachFairValueGap.top, eachFairValueGap.bottom)
        float zBot   = math.min(eachFairValueGap.top, eachFairValueGap.bottom)
        bool bull    = eachFairValueGap.bias == BULLISH
        bool inNow   = low <= zTop and high >= zBot
        bool outside = low > zTop or high < zBot

        bool confirmBody = eachFairValueGap.pinAge == 1 and (bull ? bullConfirm : bearConfirm)
        bool confirmGap  = eachFairValueGap.pinAge == 2 and (bull ? gapUp : gapDn)
        bool twoBarFire  = confirmBody or confirmGap

        if outside
            eachFairValueGap.leftZone := true
            eachFairValueGap.touched  := false

        bool pinNow = bull ? bullPin : bearPin
        bool oneBarFire = rejectionModeInput == REJ_ANY ? inNow : rejectionModeInput == REJ_CLOSE ? (inNow and (bull ? (close >= math.avg(zTop, zBot) and close > open) : (close <= math.avg(zTop, zBot) and close < open))) : rejectionModeInput == REJ_PIN ? (inNow and pinNow and (bull ? close > zBot : close < zTop)) : false
        bool fire = rejectionModeInput == REJ_CONFIRM ? twoBarFire : oneBarFire

        if fire and (eachFairValueGap.leftZone or not requireLeaveFirstInput) and not eachFairValueGap.touched and eachFairValueGap.tests < maxZoneTestsInput
            eachFairValueGap.touched := true
            eachFairValueGap.tests   += 1
            eachFairValueGap.pinAge  := 0
            string nm = rejectionModeInput != REJ_CONFIRM ? (patHammer ? 'hammer' : patHangingMan ? 'hanging man' : patInvHammer ? 'inverted hammer' : patShootingStar ? 'shooting star' : '') : (patHammer[1] ? 'hammer' : patHangingMan[1] ? 'hanging man' : patInvHammer[1] ? 'inverted hammer' : patShootingStar[1] ? 'shooting star' : '')
            if bull
                currentAlerts.demandFvgTouch := true
                currentAlerts.demandPattern  := nm + (nm != '' and rejectionModeInput == REJ_CONFIRM ? (confirmGap ? ' + displacement gap' : ' + green marubozu') : '') + (nm != '' ? ' at an FVG' : 'FVG')
                currentAlerts.demandTouchTop := zTop
                currentAlerts.demandTouchBot := zBot
            else
                currentAlerts.supplyFvgTouch := true
                currentAlerts.supplyPattern  := nm + (nm != '' and rejectionModeInput == REJ_CONFIRM ? (confirmGap ? ' + displacement gap' : ' + red marubozu') : '') + (nm != '' ? ' at an FVG' : 'FVG')
                currentAlerts.supplyTouchTop := zTop
                currentAlerts.supplyTouchBot := zBot
        else
            eachFairValueGap.pinAge := (inNow and pinAny and (eachFairValueGap.leftZone or not requireLeaveFirstInput) and not eachFairValueGap.touched and eachFairValueGap.tests < maxZoneTestsInput) ? 1 : eachFairValueGap.pinAge == 1 ? 2 : 0

        if inNow and (pinNow or twoBarFire)
            currentAlerts.zoneRejectTop := zTop
            currentAlerts.zoneRejectBot := zBot
            if bull
                currentAlerts.zoneRejectBull := true
            else
                currentAlerts.zoneRejectBear := true

deleteFairValueGaps() =>
    for [index,eachFairValueGap] in fairValueGaps
        if (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)

drawFairValueGaps() =>
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]],lookahead = barmerge.lookahead_on)

    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0

    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow,last2High,BULLISH,fairValueGapBox(lastTime,currentTime,currentLow,math.avg(currentLow,last2High),fairValueGapBullishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentLow,last2High),last2High,fairValueGapBullishColor)))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh,last2Low,BEARISH,fairValueGapBox(lastTime,currentTime,currentHigh,math.avg(currentHigh,last2Low),fairValueGapBearishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentHigh,last2Low),last2Low,fairValueGapBearishColor)))

getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time],lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel

    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime

    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex               = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex              = times.binary_search_rightmost(parsedRightTime)

        array<int> timeArray        = times.slice(leftIndex,rightIndex)
        array<float> topArray       = highs.slice(leftIndex,rightIndex)
        array<float> bottomArray    = lows.slice(leftIndex,rightIndex)

        parsedTopTime               := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime            := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime

    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    topLine.set_first_point(    chart.point.new(parsedTopTime,na,parsedTop))
    topLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))
    topLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))

    bottomLine.set_first_point( chart.point.new(parsedBottomTime,na,parsedBottom))
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))
    bottomLabel.set_point(      chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high,trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low,trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine     = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel      = label.new(na, na, color=color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel   = label.new(na, na, color=color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    rightTimeBar            = last_bar_time + 20 * (time - time[1])

    topLine.set_first_point(    chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(   chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(         chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(          swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')

    bottomLine.set_first_point( chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(      chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(       swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na,na,text = tag, color=color(na),textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na,na,na,na,bgcolor = color.new(zoneColor,80),border_color = color(na), xloc = xloc.bar_time)

    b_ox.set_top_left_point(    chart.point.new(trailing.barTime,na,top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,bottom))

    l_abel.set_point(           chart.point.new(na,labelIndex,labelLevel))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)

    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)

    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
parsedOpen  = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen,high,low,close,color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

//---------------------------------------------------------------------------------------------------------------------}
//PIN DIAGNOSTIC — every pin candle on the chart, zone or no zone. Off by default
//---------------------------------------------------------------------------------------------------------------------{
// A MISSING ARROW HAS TWO CAUSES THAT LOOK IDENTICAL: the shape was never
// recognised, or it was recognised and something downstream vetoed it. Guessing
// between them is how tuning goes wrong. These answer the first half; the ✕
// drawn further down answers the second.
//
// NEUTRAL, BECAUSE A SHAPE ON ITS OWN HAS NO DIRECTION. This was coloured by
// body first and by wick second, and BOTH were wrong for the same underlying
// reason: on a chart green and red mean bullish and bearish, and a pin candle
// standing in open space is neither.
//
// A long upper wick at a SUPPLY zone is a rejection of higher prices. The same
// candle at a DEMAND zone, in the classical reading, is an inverted hammer —
// a bottom signal waiting on confirmation. Same geometry, opposite meaning, and
// the thing that decides is the zone it landed in. Painting it red mid-rally
// with no zone anywhere near it asserts a direction nothing has established.
//
// So these say only WHICH SHAPE, in grey, and the coloured triangles further
// down — which fire per zone and take their direction from the block's bias,
// not the candle's — are the ones allowed to claim bull or bear.
//
// Diamonds rather than triangles for the same reason: a triangle points, and
// pointing is a direction claim.
plotshape(showPinDebugInput and pinLower ? low  - atrMeasure * 0.9 : na, title = 'Shape · long LOWER wick (hammer / hanging man)',         style = shape.diamond, location = location.absolute, color = color.new(GRAY, 30), size = size.tiny)
plotshape(showPinDebugInput and pinUpper ? high + atrMeasure * 0.9 : na, title = 'Shape · long UPPER wick (inverted hammer / shooting star)', style = shape.diamond, location = location.absolute, color = color.new(GRAY, 30), size = size.tiny)
//---------------------------------------------------------------------------------------------------------------------}

if showHighLowSwingsInput or showPremiumDiscountZonesInput
    updateTrailingExtremes()

    if showHighLowSwingsInput
        drawHighLowSwings()

    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()

if showFairValueGapsInput
    if alertDemandFvgInput or alertSupplyFvgInput
        touchFairValueGaps()
    deleteFairValueGaps()

getCurrentStructure(swingsLengthInput,false)
getCurrentStructure(5,false,true)

if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput,true)

if showInternalsInput or internalBlocksLive or showTrendInput or showSweepsInput
    displayStructure(true)

if showStructureInput or swingBlocksLive or showHighLowSwingsInput or showSweepsInput
    displayStructure()

// Activity and entry are accumulated BEFORE invalidation, so a block that is
// entered and broken on the same bar still reports the entry that happened
// first. Deleting first would silently drop it.
if internalBlocksLive
    updateOrderBlockActivity(true)
    touchOrderBlocks(true)
    deleteOrderBlocks(true)

if swingBlocksLive
    updateOrderBlockActivity()
    touchOrderBlocks()
    deleteOrderBlocks()

if showFairValueGapsInput
    drawFairValueGaps()

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput
        drawOrderBlocks(true)

    if showSwingOrderBlocksInput
        drawOrderBlocks()

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar          = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D',timeframe.isdaily,dailyLevelsStyleInput,dailyLevelsColorInput)

    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W',timeframe.isweekly,weeklyLevelsStyleInput,weeklyLevelsColorInput)

    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M',timeframe.ismonthly,monthlyLevelsStyleInput,monthlyLevelsColorInput)

//---------------------------------------------------------------------------------------------------------------------}
//ALERTS
//---------------------------------------------------------------------------------------------------------------------{
// The sixteen original alertcondition() entries, kept unchanged for anyone on a
// paid plan who wants one TradingView alert per event.
alertcondition(currentAlerts.internalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(currentAlerts.internalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.internalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(currentAlerts.internalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')

alertcondition(currentAlerts.swingBullishBOS,           'Bullish BOS',                  'Bullish BOS formed')
alertcondition(currentAlerts.swingBullishCHoCH,         'Bullish CHoCH',                'Bullish CHoCH formed')
alertcondition(currentAlerts.swingBearishBOS,           'Bearish BOS',                  'Bearish BOS formed')
alertcondition(currentAlerts.swingBearishCHoCH,         'Bearish CHoCH',                'Bearish CHoCH formed')

alertcondition(currentAlerts.internalBullishOrderBlock, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(currentAlerts.internalBearishOrderBlock, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')
alertcondition(currentAlerts.swingBullishOrderBlock,    'Bullish Swing OB Breakout',    'Price broke bullish swing OB')
alertcondition(currentAlerts.swingBearishOrderBlock,    'Bearish Swing OB Breakout',    'Price broke bearish swing OB')

alertcondition(currentAlerts.equalHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(currentAlerts.equalLows,                 'Equal Lows',                   'Equal lows detected')

alertcondition(currentAlerts.bullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(currentAlerts.bearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')

// ADDED — the four sweep conditions.
alertcondition(currentAlerts.swingSweepHigh,            'Swing Sweep High',             'Swing high swept and rejected')
alertcondition(currentAlerts.swingSweepLow,             'Swing Sweep Low',              'Swing low swept and rejected')
alertcondition(currentAlerts.internalSweepHigh,         'Internal Sweep High',          'Internal high swept and rejected')
alertcondition(currentAlerts.internalSweepLow,          'Internal Sweep Low',           'Internal low swept and rejected')

// TFlab's six, as their own conditions so each can be a separate TradingView
// alert with its own message, exactly as their panel offers.
alertcondition(currentAlerts.demandMainTouch,           'Demand Main Mitigation',       'Price entered a swing demand zone')
alertcondition(currentAlerts.demandSubTouch,            'Demand Sub Mitigation',        'Price entered an internal demand zone')
alertcondition(currentAlerts.demandBosTouch,            'Demand BoS Mitigation',        'Price entered a BOS-origin demand zone')
alertcondition(currentAlerts.supplyMainTouch,           'Supply Main Mitigation',       'Price entered a swing supply zone')
alertcondition(currentAlerts.supplySubTouch,            'Supply Sub Mitigation',        'Price entered an internal supply zone')
alertcondition(currentAlerts.supplyBosTouch,            'Supply BoS Mitigation',        'Price entered a BOS-origin supply zone')

// ---------------------------------------------------------------------------
// THE SINGLE ALERT. One TradingView alert on "Any alert() function call"
// delivers every event above, on every timeframe, for that symbol — which is
// what makes this usable where only one alert is allowed.
//
// Events on one bar are joined into ONE message rather than fired separately,
// because a CHoCH that also mitigates an order block is one thing happening,
// and two notifications for it is how an alert stream stops being read.
// ---------------------------------------------------------------------------
readable = alertFormatInput != 'Compact'
sep      = readable ? '  ·  ' : ';'

// The block's origin, appended to a mitigation event. TFlab keeps six separate
// alerts to say this — "Demand Main ChoCh", "Demand Sub ChoCh", "Demand BoS"
// and their supply mirrors — where Main and Sub are only swing and internal.
// The base already knows all four combinations, so one suffix says the same
// thing without six settings and six message boxes to keep in step.
bullOrigin = currentAlerts.bullishOrderBlockOrigin != '' ? (readable ? ' (' + currentAlerts.bullishOrderBlockOrigin + ' origin)' : ':' + currentAlerts.bullishOrderBlockOrigin) : ''
bearOrigin = currentAlerts.bearishOrderBlockOrigin != '' ? (readable ? ' (' + currentAlerts.bearishOrderBlockOrigin + ' origin)' : ':' + currentAlerts.bearishOrderBlockOrigin) : ''

string ev = ''
if alertStructureInput
    ev := currentAlerts.swingBullishCHoCH      ? ev + (ev == '' ? '' : sep) + (readable ? '🟢 CHoCH ↑ (swing)'   : 'SW_CHOCH_UP')   : ev
    ev := currentAlerts.swingBearishCHoCH      ? ev + (ev == '' ? '' : sep) + (readable ? '🔴 CHoCH ↓ (swing)'   : 'SW_CHOCH_DN')   : ev
    ev := currentAlerts.swingBullishBOS        ? ev + (ev == '' ? '' : sep) + (readable ? '🟢 BOS ↑ (swing)'     : 'SW_BOS_UP')     : ev
    ev := currentAlerts.swingBearishBOS        ? ev + (ev == '' ? '' : sep) + (readable ? '🔴 BOS ↓ (swing)'     : 'SW_BOS_DN')     : ev
if alertSweepInput
    ev := currentAlerts.swingSweepHigh         ? ev + (ev == '' ? '' : sep) + (readable ? '✕ swept the high'     : 'SW_SWEEP_HIGH') : ev
    ev := currentAlerts.swingSweepLow          ? ev + (ev == '' ? '' : sep) + (readable ? '✕ swept the low'      : 'SW_SWEEP_LOW')  : ev
if alertEqualInput
    ev := currentAlerts.equalHighs             ? ev + (ev == '' ? '' : sep) + 'EQH' : ev
    ev := currentAlerts.equalLows              ? ev + (ev == '' ? '' : sep) + 'EQL' : ev
if alertOrderBlockInput
    ev := currentAlerts.swingBullishOrderBlock ? ev + (ev == '' ? '' : sep) + (readable ? 'bullish OB mitigated' : 'SW_OB_BULL_MIT') + bullOrigin : ev
    ev := currentAlerts.swingBearishOrderBlock ? ev + (ev == '' ? '' : sep) + (readable ? 'bearish OB mitigated' : 'SW_OB_BEAR_MIT') + bearOrigin : ev
if alertGapInput
    ev := currentAlerts.bullishFairValueGap    ? ev + (ev == '' ? '' : sep) + (readable ? 'bullish FVG'          : 'FVG_BULL')      : ev
    ev := currentAlerts.bearishFairValueGap    ? ev + (ev == '' ? '' : sep) + (readable ? 'bearish FVG'          : 'FVG_BEAR')      : ev

// The zone-entry events. The wording is fixed and says WHICH zone was entered,
// which is more than TFlab's editable boxes can manage — theirs are written
// before anyone knows the symbol, so every chart sends the same sentence. The
// symbol, timeframe and price are attached by the message below regardless.
ev := alertDemandMainInput and currentAlerts.demandMainTouch ? ev + (ev == '' ? '' : sep) + (readable ? '🟢 demand zone entered (swing)'    : 'DEMAND_MAIN') : ev
ev := alertDemandSubInput  and currentAlerts.demandSubTouch  ? ev + (ev == '' ? '' : sep) + (readable ? '🟢 demand zone entered (internal)' : 'DEMAND_SUB')  : ev
ev := alertDemandBosInput  and currentAlerts.demandBosTouch  ? ev + (ev == '' ? '' : sep) + (readable ? '🟢 demand zone entered (BOS)'      : 'DEMAND_BOS')  : ev
ev := alertSupplyMainInput and currentAlerts.supplyMainTouch ? ev + (ev == '' ? '' : sep) + (readable ? '🔴 supply zone entered (swing)'    : 'SUPPLY_MAIN') : ev
ev := alertSupplySubInput  and currentAlerts.supplySubTouch  ? ev + (ev == '' ? '' : sep) + (readable ? '🔴 supply zone entered (internal)' : 'SUPPLY_SUB')  : ev
ev := alertSupplyBosInput  and currentAlerts.supplyBosTouch  ? ev + (ev == '' ? '' : sep) + (readable ? '🔴 supply zone entered (BOS)'      : 'SUPPLY_BOS')  : ev
ev := alertDemandFvgInput  and currentAlerts.demandFvgTouch  ? ev + (ev == '' ? '' : sep) + (readable ? '🟢 demand FVG entered'             : 'DEMAND_FVG')  : ev
ev := alertSupplyFvgInput  and currentAlerts.supplyFvgTouch  ? ev + (ev == '' ? '' : sep) + (readable ? '🔴 supply FVG entered'             : 'SUPPLY_FVG')  : ev

// Internal events are appended only when the reader wants them. They fire many
// times more often than swing events, so mixing them in by default would bury
// the slower signal that is worth opening a chart for.
if not alertSwingOnly
    if alertStructureInput
        ev := currentAlerts.internalBullishCHoCH ? ev + (ev == '' ? '' : sep) + (readable ? 'CHoCH ↑ (internal)' : 'IN_CHOCH_UP')   : ev
        ev := currentAlerts.internalBearishCHoCH ? ev + (ev == '' ? '' : sep) + (readable ? 'CHoCH ↓ (internal)' : 'IN_CHOCH_DN')   : ev
        ev := currentAlerts.internalBullishBOS   ? ev + (ev == '' ? '' : sep) + (readable ? 'BOS ↑ (internal)'   : 'IN_BOS_UP')     : ev
        ev := currentAlerts.internalBearishBOS   ? ev + (ev == '' ? '' : sep) + (readable ? 'BOS ↓ (internal)'   : 'IN_BOS_DN')     : ev
    if alertSweepInput
        ev := currentAlerts.internalSweepHigh    ? ev + (ev == '' ? '' : sep) + (readable ? '✕ internal high swept' : 'IN_SWEEP_HIGH') : ev
        ev := currentAlerts.internalSweepLow     ? ev + (ev == '' ? '' : sep) + (readable ? '✕ internal low swept'  : 'IN_SWEEP_LOW')  : ev
    if alertOrderBlockInput
        ev := currentAlerts.internalBullishOrderBlock ? ev + (ev == '' ? '' : sep) + (readable ? 'internal bullish OB mitigated' : 'IN_OB_BULL_MIT') + bullOrigin : ev
        ev := currentAlerts.internalBearishOrderBlock ? ev + (ev == '' ? '' : sep) + (readable ? 'internal bearish OB mitigated' : 'IN_OB_BEAR_MIT') + bearOrigin : ev

bias      = swingTrend.bias == BULLISH ? 'bull' : swingTrend.bias == BEARISH ? 'bear' : 'flat'
inBias    = internalTrend.bias == BULLISH ? 'bull' : internalTrend.bias == BEARISH ? 'bear' : 'flat'

// ---------------------------------------------------------------------------
// TWO MARKS, AND THE DIFFERENCE BETWEEN THEM IS THE WHOLE POINT.
//
// The setup has two halves and the old build drew only one of them, at one
// weight, so the chart could not tell "wait" from "go":
//
//   ○  A BREAK CUT A ZONE.  Structure moved and left a demand or supply zone
//      at the origin. There is NOTHING TO DO. Mark the zone and wait for price
//      to come back to it. A hollow dot on the zone's midline, dim.
//
//   ▲▼ PRICE CAME BACK AND REJECTED.  The retest happened and the bar closed
//      back out of the zone's better half. That is the entry the dot was
//      waiting for, and it gets the only bold mark on the chart.
//
// A dot with no arrow after it is a setup that did not complete — the retest
// never came, or came and walked straight through. That is worth seeing.
// ---------------------------------------------------------------------------
demandEntry = currentAlerts.demandMainTouch or currentAlerts.demandSubTouch or currentAlerts.demandBosTouch or currentAlerts.demandFvgTouch
supplyEntry = currentAlerts.supplyMainTouch or currentAlerts.supplySubTouch or currentAlerts.supplyBosTouch or currentAlerts.supplyFvgTouch

// WITH-STRUCTURE FILTER, ON BY DEFAULT, AND THIS IS THE MEASURED ONE. A supply
// block forms above every impulse leg, so in a rally price walks back into
// supply constantly and each of those touches used to print a down arrow in
// the middle of an uptrend. Counter-trend entries measured -0.588 R against
// +0.038 R for the identical construction taken with the trend — the largest
// separation found anywhere in this research. Turning this off shows every
// touch; it does not make those touches better.
bullArrow = demandEntry and (not signalWithTrendInput or swingTrend.bias == BULLISH)
bearArrow = supplyEntry and (not signalWithTrendInput or swingTrend.bias == BEARISH)

// THE LAST GATE SITS OUT HERE, NOT IN touchOrderBlocks, so a setup that cleared
// every zone test and was then killed by the structure filter would otherwise
// leave no trace at all — the ✕ inside the loop never fires for it.
if (demandEntry and not bullArrow) or (supplyEntry and not bearArrow)
    currentAlerts.pinVetoed  := true
    currentAlerts.vetoReason := 'the retest completed, but Signals With Structure Only is on and swing structure is ' + (swingTrend.bias == BULLISH ? 'bull' : swingTrend.bias == BEARISH ? 'bear' : 'flat') + ' against a ' + (demandEntry and not bullArrow ? 'demand' : 'supply') + ' entry'

if ev != ''
    lastEventText := ev
    lastEventTime := time
    // --- TIER TWO: the retest rejected, this is the entry -------------------
    //
    // Both directions on one bar can only happen with the structure filter
    // off, since the swing bias cannot be bullish and bearish at once. When it
    // does, the side facing the swing bias wins rather than drawing two
    // opposing arrows on the same candle.
    if showSignalArrowInput and (bullArrow or bearArrow)
        bool down = bearArrow and (not bullArrow or swingTrend.bias == BEARISH)
        float at  = down ? high + atrMeasure * 0.4 : low - atrMeasure * 0.4
        color css = down ? swingBearishColor : swingBullishColor
        float zTop = down ? currentAlerts.supplyTouchTop : currentAlerts.demandTouchTop
        float zBot = down ? currentAlerts.supplyTouchBot : currentAlerts.demandTouchBot
        string patName = down ? currentAlerts.supplyPattern : currentAlerts.demandPattern
        float stopAt = down ? zTop : zBot
        float riskPc = na(stopAt) ? na : 100 * math.abs(close - stopAt) / close
        string band  = na(riskPc) ? '' : riskPc > 2.6 ? '  skip, too wide' : riskPc < 1.2 ? '  tight, fees bite' : '  take'
        string detail = (na(zTop) ? '' : 'zone  ' + str.tostring(zBot, format.mintick) + ' – ' + str.tostring(zTop, format.mintick) + '\n')
             + (na(stopAt) ? '' : 'stop  ' + str.tostring(stopAt, format.mintick) + '  ·  ' + str.tostring(riskPc, '#.##') + '%' + band)
        label.new(chart.point.new(time, na, at), '', xloc.bar_time,
             color = css,
             textcolor = css,
             style = down ? label.style_arrowdown : label.style_arrowup,
             size = signalArrowSizeInput,
             tooltip = eventTooltip((down ? 'Supply held' : 'Demand held') + (patName != '' ? '  ·  ' + patName : ''), close, detail))
    if alertOnInput
        // TWO FIXED SHAPES, no template to fill in. Both already carry the
        // symbol, the timeframe and the price, which is the part that actually
        // has to be there and the part a hand-written message cannot supply.
        string body = readable
             ? str.format('{0} {1}\n{2}\n{3}  ·  swing {4} · internal {5}', syminfo.ticker, timeframe.period, ev, str.tostring(close, format.mintick), bias, inBias)
             : str.format('{0}|{1}|{2}|{3}|{4}|{5}',            syminfo.ticker, timeframe.period, ev, str.tostring(close, format.mintick), bias, inBias)
        alert(body, alert.freq_once_per_bar_close)

//---------------------------------------------------------------------------------------------------------------------}
//ZONE MARKS — drawn LAST, after every gate has had its say
//---------------------------------------------------------------------------------------------------------------------{
// THESE SIT BELOW THE ARROW BLOCK AND THAT IS DELIBERATE. The structure filter
// runs out there, so a setup that cleared every zone test and was then killed
// by it only becomes known at this point. Drawn any earlier, the ✕ would report
// a stale reason and quietly omit the most common one of all.
//
// Labels rather than plotshape, because "which pattern was that" and "why was
// there no arrow" are the questions these exist to answer, and a plotshape
// cannot be hovered. The debug pin triangles stay plotshapes: there can be
// hundreds of them and position plus colour already say everything.
if showZoneRejectInput and (currentAlerts.zoneRejectBull or currentAlerts.zoneRejectBear)
    bool rjDown = currentAlerts.zoneRejectBear and not currentAlerts.zoneRejectBull
    label.new(chart.point.new(time, na, rjDown ? high + atrMeasure * 0.35 : low - atrMeasure * 0.35), '', xloc.bar_time,
         color = rjDown ? swingBearishColor : swingBullishColor,
         style = rjDown ? label.style_triangledown : label.style_triangleup,
         size = size.tiny,
         tooltip = eventTooltip((rjDown ? 'Rejection at supply' : 'Rejection at demand') + (currentAlerts.zoneRejectName != '' ? '  ·  ' + currentAlerts.zoneRejectName : ''), close, (na(currentAlerts.zoneRejectTop) ? '' : 'zone  ' + str.tostring(currentAlerts.zoneRejectBot, format.mintick) + ' – ' + str.tostring(currentAlerts.zoneRejectTop, format.mintick) + '\n') + 'shape only — not the retest entry'))

if showPinDebugInput and currentAlerts.pinVetoed
    label.new(chart.point.new(time, na, low - atrMeasure * 1.5), '', xloc.bar_time,
         color = GRAY, style = label.style_xcross, size = size.tiny,
         tooltip = eventTooltip('No arrow here', close, currentAlerts.vetoReason))

//---------------------------------------------------------------------------------------------------------------------}
//STATUS READ-OUT — off by default, so the chart looks exactly like the base
//---------------------------------------------------------------------------------------------------------------------{
// For scanning many charts quickly: which way both structures currently lean,
// and what the last event was. It answers "is this one worth opening" without
// reading the chart, which is the job this build exists to do.
if showDashInput and barstate.islast
    var table dash = table.new(position.top_right, 2, 3, border_width = 1)
    biasColor   = swingTrend.bias == BULLISH ? swingBullishColor : swingTrend.bias == BEARISH ? swingBearishColor : GRAY
    inBiasColor = internalTrend.bias == BULLISH ? swingBullishColor : internalTrend.bias == BEARISH ? swingBearishColor : GRAY
    dash.cell(0, 0, 'swing',    text_color = GRAY, text_size = size.small)
    dash.cell(1, 0, bias,       text_color = biasColor, text_size = size.small)
    dash.cell(0, 1, 'internal', text_color = GRAY, text_size = size.small)
    dash.cell(1, 1, inBias,     text_color = inBiasColor, text_size = size.small)
    dash.cell(0, 2, 'last',     text_color = GRAY, text_size = size.small)
    dash.cell(1, 2, lastEventText, text_color = chart.fg_color, text_size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
