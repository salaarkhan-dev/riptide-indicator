// RIPTIDE FORK — private, non-commercial use, which CC BY-NC-SA permits.
//
// The LuxAlgo script below is UNCHANGED except for the version tag and the
// indicator name. Every input, every drawing and every alert it had still
// works exactly as it did. An earlier attempt rewrote the structure engine
// from scratch and lost all of it; this does not.
//
// The Riptide DPA layer is APPENDED at the bottom of the file. It adds nothing
// to the middle and rewrites none of it — it reads LuxAlgo's own state
// (swingHigh, swingLow, internalTrend, trailing, currentAlerts, the order block
// and fair value gap arrays) and builds the dailypriceaction.com liquidity-sweep
// model on top of it.
// ─────────────────────────────────────────────────────────────────────────────

//@version=6
indicator('Riptide SMC — LuxAlgo + DPA', 'Riptide SMC', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_LEG                     = 1
BEARISH_LEG                     = 0

BULLISH                         = +1
BEARISH                         = -1

GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GRAY                            = #878b94
MONO_BULLISH                    = #b2b5be
MONO_BEARISH                    = #5d606b

HISTORICAL                      = 'Historical'
PRESENT                         = 'Present'

COLORED                         = 'Colored'
MONOCHROME                      = 'Monochrome'

ALL                             = 'All'
BOS                             = 'BOS'
CHOCH                           = 'CHoCH'

TINY                            = size.tiny
SMALL                           = size.small
NORMAL                          = size.normal

ATR                             = 'Atr'
RANGE                           = 'Cumulative Mean Range'

CLOSE                           = 'Close'
HIGHLOW                         = 'High/Low'

