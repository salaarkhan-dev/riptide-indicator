// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
//  Riptide Scalper — LSR-4: previous-HTF-bar raid, reclaim, first FVG
//
//  READ THIS BEFORE YOU TRADE FROM IT.
//
//  This draws the ONE scalping model out of seven that produced a real edge in
//  research/studies/scalp_lab.py — and that edge did NOT survive execution
//  costs. Measured over 13,887 trades, 14 symbols, 30 days of 1m data:
//
//      gross    +0.202 R at a 2R target, 42% win
//               positive on 14 of 14 symbols
//               day-block bootstrap 95% CI  +0.190 .. +0.220
//               control (traded backwards)  -0.36
//
//      NET      +0.027 R after live spread
//               6 of the 14 symbols went NEGATIVE
//               only 1 stayed above +0.15
//
//  So the pattern is real and the trade is marginal. The gap between those two
//  numbers is the spread, and the whole reason the COST panel below exists: on
//  this model, the symbol you pick matters more than the setup you find.
//
//  It is a chart aid for a model under test. It is not a signal, it is not
//  deployed, and Riptide's Min30 strategy is untouched and remains the control.
//
//  THE MODEL, IN ONE LINE. Price dips below the previous completed 5-minute
//  bar's low, closes back above it, and the first 1-minute fair-value gap after
//  that reclaim is the limit entry. Stop beyond the raid. That is all of it —
//  no oscillators, no averages, no thresholds to tune.
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
//@version=6
indicator('Riptide Scalper', 'RIPTIDE SCALP', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────── inputs

g_setup = 'Setup'
g_risk  = 'Risk & Targets'
g_cost  = 'Cost — the thing that decides this model'
g_disp  = 'Display'

htf = input.timeframe('5', 'Liquidity timeframe', group = g_setup, tooltip = 'Which timeframe supplies the level being raided.\n\nThe measured model used the PREVIOUS COMPLETED 5-minute bar, read on a 1-minute chart. That pairing is what produced +0.202R gross; 3m and 15m were not tested as the liquidity source for this model and are offered only so you can look.\n\nThe level is the previous bar\'s high (for shorts) and low (for longs). It updates once per HTF close and never repaints.')

maxWaitRaid = input.int(240, 'Bars a level stays live', minval = 10, maxval = 1000, group = g_setup, tooltip = 'How many 1-minute bars a level remains eligible to be raided before it is dropped.\n\n240 is four hours, which is what the backtest used. A level nobody has touched in four hours is not liquidity anyone is defending.')
maxWaitFvg  = input.int(25, 'Bars to find the gap', minval = 3, maxval = 100, group = g_setup, tooltip = 'After the reclaim, how many bars to wait for a fair-value gap to form.\n\nIf no gap appears in this window the setup is discarded rather than entered at market. The backtest used 25.')
fillBars    = input.int(10, 'Bars the limit waits', minval = 1, maxval = 60, group = g_setup, tooltip = 'How long the limit order stays working before it is cancelled.\n\n10 bars, the same rule Riptide\'s own tracker uses. A setup that has not pulled back in ten minutes has moved on without you, and chasing it is the single most expensive habit this project has measured.')

rTarget  = input.float(2.0, 'Target (R)', minval = 0.25, maxval = 5, step = 0.25, group = g_risk, tooltip = 'Reward as a multiple of the stop distance.\n\nMeasured gross R per trade, 13,887 trades:\n  0.75R → +0.094   (55% win)\n  1.0R  → +0.094   (55% win)\n  1.5R  → +0.152   (47% win)\n  2.0R  → +0.202   (42% win)\n\nMonotone — the further target paid more in this sample. Note the win rate falling as it does: at 2R you are wrong most of the time and it is still the best column.')
stopPad  = input.float(0.05, 'Stop padding (%)', minval = 0, maxval = 1, step = 0.01, group = g_risk, tooltip = 'Extra distance beyond the raid extreme, as a percentage of price.\n\nThe backtest used 0.05%. It exists so a stop is not sitting exactly on the wick that everyone else can see.')
minStopPct = input.float(0.0, 'Minimum stop (%)', minval = 0, maxval = 2, step = 0.05, group = g_risk, tooltip = 'A floor on the stop distance, in percent.\n\n0 uses the raw structural stop, which is what scalp_lab measured. Raising it is the experiment in research/studies/scalp_wide.py: cost in R is spread ÷ stop%, so a wider stop mechanically cuts the cost ratio — at the price of a target that sits further away and resolves less often.\n\nIf you find yourself needing a large floor here to make the cost panel green, the honest reading is that this has become a slower-timeframe strategy wearing a 1-minute label.')

spreadPct = input.float(0.02, 'Your measured spread (%)', minval = 0, maxval = 1, step = 0.001, group = g_cost, tooltip = 'The bid-ask spread on THIS symbol, as a percentage. Read it off the order book and type it in — Pine cannot see the book.\n\nThis is the number that decided the whole study. Measured across the 14 tested symbols it ranged 0.016% to 0.111%, and that range alone moved the model from +0.206R net to -0.281R net.\n\nCost in R = spread ÷ stop%. The panel turns red above 0.15R, the level at which the spread is deciding the outcome rather than the setup.')
warnCostR = input.float(0.15, 'Warn above cost (R)', minval = 0.01, maxval = 1, step = 0.01, group = g_cost, tooltip = 'The cost ratio above which the panel turns red.\n\n0.15R is the floor used in the study: below it the unmeasured spread and slippage decide the trade, not the edge. Six of the fourteen tested symbols failed it.')

showLevels = input.bool(true, 'Liquidity levels', group = g_disp)
showGaps   = input.bool(true, 'Fair value gap', group = g_disp)
showTrade  = input.bool(true, 'Entry, stop and target', group = g_disp)
showPanel  = input.bool(true, 'Dashboard', group = g_disp)
maxMarks   = input.int(6, 'Keep last N raid markers', minval = 1, maxval = 50, group = g_disp, tooltip = 'Raid markers accumulate and are the other half of what makes a 1m chart unreadable. Only the most recent N survive; the rest are deleted, not hidden.')
colLong    = input.color(#26a69a, 'Long', inline = 'c', group = g_disp)
colShort   = input.color(#ef5350, 'Short', inline = 'c', group = g_disp)

// ──────────────────────────────────────────────────────── the liquidity levels

// Previous COMPLETED higher-timeframe bar. lookahead_off and the [1] offset are
// both required: without them this reads a bar that has not finished and every
// number on the chart becomes a lie that backtests beautifully.
htfHigh = request.security(syminfo.tickerid, htf, high[1], lookahead = barmerge.lookahead_off)
htfLow  = request.security(syminfo.tickerid, htf, low[1],  lookahead = barmerge.lookahead_off)
newHtf  = ta.change(htfHigh) != 0 or ta.change(htfLow) != 0

var float liqHigh   = na
var int   liqHighAt = na
var float liqLow    = na
var int   liqLowAt  = na

if newHtf
    liqHigh   := htfHigh
    liqHighAt := bar_index
    liqLow    := htfLow
    liqLowAt  := bar_index

// ────────────────────────────────────────────────────────────── state machines

// 0 idle · 1 raided, waiting for a gap · 2 limit working
var int   lState = 0
var float lStop  = na
var float lEntry = na
var int   lSince = 0
var int   sState = 0
var float sStop  = na
var float sEntry = na
var int   sSince = 0

// A raid is a wick THROUGH the level with a close back on the original side.
// Both halves matter: through without a reclaim is a breakout, and a reclaim
// without a wick through never took the liquidity in the first place.
raidLong  = not na(liqLow)  and bar_index - liqLowAt  <= maxWaitRaid and low  < liqLow  and close > liqLow
raidShort = not na(liqHigh) and bar_index - liqHighAt <= maxWaitRaid and high > liqHigh and close < liqHigh

// A three-bar imbalance: bar-2's extreme and this bar's extreme do not overlap.
bullGap = low > high[2]
bearGap = high < low[2]

if lState == 0 and raidLong
    lState := 1
    lSince := 0
    lStop  := low
else if lState == 1
    lSince += 1
    lStop  := math.min(lStop, low)
    if bullGap
        lState := 2
        lSince := 0
        lEntry := low
    else if lSince > maxWaitFvg
        lState := 0
else if lState == 2
    lSince += 1
    if low <= lEntry or lSince > fillBars
        lState := 0

if sState == 0 and raidShort
    sState := 1
    sSince := 0
    sStop  := high
else if sState == 1
    sSince += 1
    sStop  := math.max(sStop, high)
    if bearGap
        sState := 2
        sSince := 0
        sEntry := high
    else if sSince > maxWaitFvg
        sState := 0
else if sState == 2
    sSince += 1
    if high >= sEntry or sSince > fillBars
        sState := 0

// ───────────────────────────────────────────────────── prices for the live one

padOf(float px) =>
    px * stopPad / 100

f_stopFor(bool isLong, float entry, float raw) =>
    float s = isLong ? raw - padOf(raw) : raw + padOf(raw)
    if minStopPct > 0
        float floorDist = entry * minStopPct / 100
        s := isLong ? math.min(s, entry - floorDist) : math.max(s, entry + floorDist)
    s

isLive   = lState == 2 or sState == 2
liveLong = lState == 2
entryPx  = liveLong ? lEntry : sState == 2 ? sEntry : na
stopRaw  = liveLong ? lStop  : sState == 2 ? sStop  : na
stopPx   = isLive ? f_stopFor(liveLong, entryPx, stopRaw) : na
riskPx   = isLive ? math.abs(entryPx - stopPx) : na
targetPx = isLive ? (liveLong ? entryPx + riskPx * rTarget : entryPx - riskPx * rTarget) : na
riskPct  = isLive and entryPx > 0 ? 100 * riskPx / entryPx : na
costR    = isLive and riskPct > 0 ? spreadPct / riskPct : na
// Declared here with the other derived values. It lived in the drawing
// section until that block was rewritten, which is how it went missing.
tradeCol = liveLong ? colLong : colShort

// ────────────────────────────────────────────────────────────────────── drawing
//
// OBJECTS, NOT plot(). The first version used plot(..., style_linebr) for the
// liquidity levels, and on a 1m chart that draws ONE STEP PER 5m BAR across the
// entire history — the red and teal staircase running over every candle, which
// is what made the chart unreadable. A level is one price that is either live
// or gone, so it is ONE line object that gets moved and then deleted. The trade
// is one zone, drawn only while it exists.

EXT   = 12          // bars a live level reaches to the right
LOOKB = 60          // furthest back a level's line is anchored

var line hiLn  = na
var line loLn  = na
var line entLn = na
var box  winBox  = na
var box  lossBox = na
var box  gapBox  = na
var label[] marks = array.new<label>()

f_level(line ln, float px, int since, color c, bool show) =>
    line out = ln
    if show and not na(px)
        int left = math.max(since, bar_index - LOOKB)
        if na(out)
            out := line.new(left, px, bar_index + EXT, px, color = c, width = 1, style = line.style_dotted)
        else
            line.set_xy1(out, left, px)
            line.set_xy2(out, bar_index + EXT, px)
            line.set_color(out, c)
    else if not na(out)
        line.delete(out)
        out := na
    out

// A level is worth drawing only while it can still be raided.
hiAlive = showLevels and not na(liqHigh) and bar_index - liqHighAt <= maxWaitRaid and sState == 0
loAlive = showLevels and not na(liqLow) and bar_index - liqLowAt <= maxWaitRaid and lState == 0
hiLn := f_level(hiLn, liqHigh, liqHighAt, color.new(colShort, 35), hiAlive)
loLn := f_level(loLn, liqLow, liqLowAt, color.new(colLong, 35), loAlive)

// Raid markers, capped. Unbounded labels are the other half of the clutter.
f_mark(bool up, float px, string tip) =>
    lb = label.new(bar_index, px, '', style = up ? label.style_triangleup : label.style_triangledown, color = up ? colLong : colShort, size = size.tiny, tooltip = tip)
    array.push(marks, lb)
    if array.size(marks) > maxMarks
        label.delete(array.shift(marks))

if raidLong and showLevels
    f_mark(true, low, 'LIQUIDITY TAKEN below the previous ' + htf + ' low at ' + str.tostring(liqLow, format.mintick) + '.\n\nThe wick went through and the bar closed back above. Now waiting for a fair value gap — none within ' + str.tostring(maxWaitFvg) + ' bars and the setup is dropped rather than chased.')
if raidShort and showLevels
    f_mark(false, high, 'LIQUIDITY TAKEN above the previous ' + htf + ' high at ' + str.tostring(liqHigh, format.mintick) + '.\n\nThe wick went through and the bar closed back below. Now waiting for a fair value gap — none within ' + str.tostring(maxWaitFvg) + ' bars and the setup is dropped.')

// The trade: reward above the entry, risk below it, so the SHAPE is the ratio.
if showTrade
    if isLive
        int L = bar_index - 2
        int R = bar_index + EXT
        if na(winBox)
            winBox := box.new(L, math.max(targetPx, entryPx), R, math.min(targetPx, entryPx), border_color = color.new(color.green, 65), bgcolor = color.new(color.green, 90))
            lossBox := box.new(L, math.max(entryPx, stopPx), R, math.min(entryPx, stopPx), border_color = color.new(color.red, 65), bgcolor = color.new(color.red, 90))
            entLn := line.new(L, entryPx, R, entryPx, color = tradeCol, width = 2)
        else
            box.set_lefttop(winBox, L, math.max(targetPx, entryPx))
            box.set_rightbottom(winBox, R, math.min(targetPx, entryPx))
            box.set_lefttop(lossBox, L, math.max(entryPx, stopPx))
            box.set_rightbottom(lossBox, R, math.min(entryPx, stopPx))
            line.set_xy1(entLn, L, entryPx)
            line.set_xy2(entLn, R, entryPx)
            line.set_color(entLn, tradeCol)
    else if not na(winBox)
        box.delete(winBox)
        box.delete(lossBox)
        line.delete(entLn)
        winBox := na
        lossBox := na
        entLn := na

// Only the gap being traded, and only one at a time.
if showGaps and ((lState == 2 and lState[1] != 2) or (sState == 2 and sState[1] != 2))
    if not na(gapBox)
        box.delete(gapBox)
    bull = lState == 2
    gapBox := box.new(bar_index - 2, bull ? low : low[2], bar_index + 2, bull ? high[2] : high, border_color = color.new(bull ? colLong : colShort, 55), bgcolor = color.new(bull ? colLong : colShort, 82))

// ──────────────────────────────────────────────────────────────────── dashboard

var table dash = table.new(position.top_right, 2, 6, border_width = 0, frame_width = 1, frame_color = #2a2e39)

f_state() =>
    lState == 2 or sState == 2 ? 'LIMIT WORKING' : lState == 1 or sState == 1 ? 'waiting for gap' : 'watching'

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = #787b86, bgcolor = #131722, text_size = size.normal, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, bgcolor = #131722, text_size = size.normal, text_halign = text.align_right)

if barstate.islast and showPanel
    stateCol = isLive ? tradeCol : (lState == 1 or sState == 1) ? color.orange : #787b86
    f_row(0, 'RIPTIDE SCALP', htf + ' → ' + timeframe.period, #d1d4dc)
    f_row(1, 'state', f_state(), stateCol)
    f_row(2, 'entry', isLive ? str.tostring(entryPx, format.mintick) : '—', #d1d4dc)
    f_row(3, 'stop', isLive ? str.tostring(stopPx, format.mintick) + '   ' + str.tostring(riskPct, '#.##') + '%' : '—', #d1d4dc)
    f_row(4, 'target ' + str.tostring(rTarget, '#.##') + 'R', isLive ? str.tostring(targetPx, format.mintick) : '—', #d1d4dc)
    // THE ROW THAT DECIDES THE TRADE. Gross +0.202R became net +0.027R across
    // the tested symbols purely through this ratio, so it is not a footnote.
    costCol = na(costR) ? #787b86 : costR > warnCostR ? #f23645 : costR > warnCostR / 2 ? #ff9800 : #26a69a
    f_row(5, 'spread cost', isLive ? str.tostring(costR, '#.##') + 'R → net ' + str.tostring(0.202 - costR, '+#.##') : '—', costCol)


// ─────────────────────────────────────────────────────────────────────── alerts

alertcondition(raidLong,  'Liquidity taken below', 'Previous {{interval}} low raided and reclaimed on {{ticker}}')
alertcondition(raidShort, 'Liquidity taken above', 'Previous {{interval}} high raided and reclaimed on {{ticker}}')
alertcondition(lState == 2 and lState[1] != 2, 'Long limit armed',  'Riptide Scalp LONG limit armed on {{ticker}} at {{close}}')
alertcondition(sState == 2 and sState[1] != 2, 'Short limit armed', 'Riptide Scalp SHORT limit armed on {{ticker}} at {{close}}')
